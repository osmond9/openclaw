**关键逻辑**：
```python
def _classify_scene_tag(df, cond, cols):
    # 熄火静置细分（新增）
    is_rest_off_hot_soc = (
        c['c_voff'] &              # 熄火
        (maxt >= 35.0) &           # 高温
        (soc >= 80.0)              # 高SOC
    )
    is_rest_off = c['c_voff'] & ~is_rest_off_hot_soc
    
    return np.select(
        [..., is_rest_off_hot_soc, is_rest_on, is_rest_off, ...],
        [..., 'rest_off_hot_soc', 'rest_on', 'rest_off', ...],
        default='unknown'
    )
```

