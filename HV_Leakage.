"""
battery_risk/modules/load_risk.py
L2d 负荷风险评分
"""

import numpy as np
import pandas as pd

from battery_risk.config import (
    LOAD_CURRENT_HIGH, LOAD_DISCHARGE_CURRENT_HIGH,
    LOAD_POWER_HIGH_KW, LOAD_DISCHARGE_POWER_HIGH,
    LOAD_SOC_LOW, LOAD_SPEED_HIGH,
    MOTOR_TEMP_HIGH, CONTROLLER_TEMP_HIGH,
    HARD_ACC_THRESHOLD, HARD_BRAKE_THRESHOLD,
    DISCHARGE_CURRENT_WARNING, DISCHARGE_CURRENT_HIGH,
    SOC_LOW_ZONE, SOC_CRITICAL_LOW,
    SPEED_HIGH, REGEN_SPEED_MIN,
    MSTATE_GEN,
)


def calc_load_risk(df: pd.DataFrame) -> dict:
    """
    负荷风险评分主入口
    输入：单辆车已完成工况识别的DataFrame
    输出：{'load_risk_score': float, ...}
    """
    if df.empty:
        return _zero_result()

    tbc   = pd.to_numeric(df.get('tbc',   0), errors='coerce').fillna(0)
    tbv   = pd.to_numeric(df.get('tbv',   0), errors='coerce').fillna(0)
    speed = pd.to_numeric(df.get('speed', 0), errors='coerce').fillna(0)
    soc   = pd.to_numeric(df.get('soc',  50), errors='coerce').fillna(50)
    tag   = df.get('scene_tag', pd.Series('unknown', index=df.index))

    # 电机温度
    mtemp0 = pd.to_numeric(df.get('mtemp_0',  pd.Series(np.nan, index=df.index)),
                            errors='coerce').fillna(0)
    mtemp1 = pd.to_numeric(df.get('mtemp_1',  pd.Series(np.nan, index=df.index)),
                            errors='coerce').fillna(0)
    # 控制器温度
    mctemp0 = pd.to_numeric(df.get('mctemp_0', pd.Series(np.nan, index=df.index)),
                             errors='coerce').fillna(0)
    mctemp1 = pd.to_numeric(df.get('mctemp_1', pd.Series(np.nan, index=df.index)),
                             errors='coerce').fillna(0)
    # 加速度
    ad = pd.to_numeric(df.get('ad', pd.Series(np.nan, index=df.index)),
                       errors='coerce')

    is_drive = tag == 'drive'

    # ── 子项1: 大电流放电 ────────────────────────────────────
    high_discharge    = tbc > DISCHARGE_CURRENT_HIGH
    warning_discharge = tbc > DISCHARGE_CURRENT_WARNING
    persist_high = (
        high_discharge.rolling(10, min_periods=1).sum() >= 8
    )
    s_high_current = float(np.clip(
        high_discharge.mean()    * 0.5 +
        warning_discharge.mean() * 0.2 +
        persist_high.mean()      * 0.3,
        0, 1
    ))

    # ── 子项2: 低SOC高负荷联合 ──────────────────────────────
    low_soc_high_load  = (soc < SOC_LOW_ZONE)     & (tbc > DISCHARGE_CURRENT_WARNING)
    crit_soc_load      = (soc < SOC_CRITICAL_LOW)  & (tbc > 50.0)
    s_soc_load = float(np.clip(
        low_soc_high_load.mean() * 0.6 +
        crit_soc_load.mean()     * 0.4,
        0, 1
    ))

    # ── 子项3: 高速大电流 ────────────────────────────────────
    high_speed_load = (speed > SPEED_HIGH) & (tbc > DISCHARGE_CURRENT_HIGH)
    s_speed_load    = float(np.clip(high_speed_load.mean() * 5.0, 0, 1))

    # ── 子项4: 电机温度 ──────────────────────────────────────
    any_motor_hot = (mtemp0 > MOTOR_TEMP_HIGH) | (mtemp1 > MOTOR_TEMP_HIGH)
    s_motor_temp  = float(np.clip(any_motor_hot.mean() * 3.0, 0, 1))

    # ── 子项5: 控制器温度 ────────────────────────────────────
    any_ctrl_hot = (mctemp0 > CONTROLLER_TEMP_HIGH) | \
                   (mctemp1 > CONTROLLER_TEMP_HIGH)
    s_ctrl_temp  = float(np.clip(any_ctrl_hot.mean() * 3.0, 0, 1))

    # ── 子项6: 急加减速 ──────────────────────────────────────
    if not ad.isna().all():
        hard_acc   = ad > HARD_ACC_THRESHOLD
        hard_brake = ad < HARD_BRAKE_THRESHOLD
        hard_ops   = hard_acc | hard_brake
        s_hard_ops = float(np.clip(hard_ops.mean() * 2.0, 0, 1))
    else:
        s_hard_ops = 0.0

    # ── 子项7: 制动回收大电流 ────────────────────────────────
    regen_mask     = tag == 'regen_braking'
    regen_high_cur = regen_mask & (tbc.abs() > 80.0)
    s_regen_load   = float(np.clip(regen_high_cur.mean() * 5.0, 0, 1))

    # ── 综合得分 ─────────────────────────────────────────────
    load_risk_score = float(np.clip(
        s_high_current * 0.30 +
        s_soc_load     * 0.25 +
        s_speed_load   * 0.15 +
        s_motor_temp   * 0.10 +
        s_ctrl_temp    * 0.10 +
        s_hard_ops     * 0.05 +
        s_regen_load   * 0.05,
        0, 1
    ))

    return {
        'load_risk_score':         load_risk_score,
        'load_high_current_score': round(s_high_current, 4),
        'load_soc_load_score':     round(s_soc_load,     4),
        'load_speed_load_score':   round(s_speed_load,   4),
        'load_motor_temp_score':   round(s_motor_temp,   4),
        'load_ctrl_temp_score':    round(s_ctrl_temp,    4),
        'load_hard_ops_score':     round(s_hard_ops,     4),
        'load_regen_score':        round(s_regen_load,   4),
        'max_discharge_current':   round(float(tbc.max()), 2),
        'high_discharge_ratio':    round(float(high_discharge.mean()), 4),
    }


def _zero_result():
    return {
        'load_risk_score':         0.0,
        'load_high_current_score': 0.0,
        'load_soc_load_score':     0.0,
        'load_speed_load_score':   0.0,
        'load_motor_temp_score':   0.0,
        'load_ctrl_temp_score':    0.0,
        'load_hard_ops_score':     0.0,
        'load_regen_score':        0.0,
        'max_discharge_current':   0.0,
        'high_discharge_ratio':    0.0,
    }
