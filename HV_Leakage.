# 📄 main.py

```python
"""
main.py
动力电池风险识别系统 v1.0 主入口
内存安全版：不在外部加载全量数据，由Pipeline内部按VIN批次处理
"""

import sys
import time
import warnings
warnings.filterwarnings('ignore')

from battery_risk.pipeline import BatteryRiskPipeline
from battery_risk.config import (
    LABELED_DATA_PATH,
    OUTPUT_RISK_PATH,
)


def main():
    print("=" * 60)
    print("  动力电池风险识别系统  v1.0")
    print("=" * 60)

    t0 = time.time()

    # Pipeline 内部按VIN批次读取，不做全量加载
    # vin_batch_size 根据可用内存调整：
    #   8GB  → 1,  16GB → 2,  32GB → 4,  64GB → 8
    pipeline = BatteryRiskPipeline(
        data_path      = LABELED_DATA_PATH,
        output_path    = OUTPUT_RISK_PATH,
        vin_batch_size = 2,
        verbose        = True,
    )

    result_df = pipeline.run()

    elapsed = time.time() - t0
    print(f"\n[INFO] 全部完成，耗时 {elapsed/60:.1f} 分钟")
    print(f"[INFO] 结果已保存至: {OUTPUT_RISK_PATH}")
    print(f"\n{'='*60}")
    print("  风险等级分布")
    print(f"{'='*60}")

    if result_df is not None and not result_df.empty:
        dist = result_df['risk_level_cn'].value_counts()
        for level, cnt in dist.items():
            pct = cnt / len(result_df) * 100
            print(f"  {level:<10} {cnt:>4} 辆  ({pct:.1f}%)")
        print(f"\n  平均综合风险分: "
              f"{result_df['final_risk_score'].mean():.4f}")
        print(f"  最高综合风险分: "
              f"{result_df['final_risk_score'].max():.4f}")

        # 打印高风险车辆
        high_risk = result_df[
            result_df['risk_level_code'] >= 2
        ].sort_values('final_risk_score', ascending=False)
        if not high_risk.empty:
            print(f"\n[警告] 发现 {len(high_risk)} 辆高风险/极高风险车辆:")
            for _, row in high_risk.iterrows():
                print(f"  VIN={row['vin']:<20} "
                      f"分={row['final_risk_score']:.4f} "
                      f"等级={row['risk_level_cn']}")

    print("=" * 60)
    return result_df


if __name__ == '__main__':
    result = main()
    sys.exit(0)
```

