"""
battery_risk/modules/operating_scene.py
L1 工况识别模块 —— 给每条记录打上工况标签
"""

import numpy as np
import pandas as pd

from battery_risk.config import (
    VSTATE_ON, VSTATE_OFF,
    CSTATE_NO_CHARGE, CSTATE_STOP_CHARGE,
    CSTATE_CHARGE_DONE, CSTATE_DRIVE_CHARGE,
    CSTATE_PARK_CHARGE_SET, CSTATE_CHARGING_SET,
    DCSTATE_WORK, DCSTATE_DISCONNECT,
    GEAR_HAS_DRIVE_SET, GEAR_NO_DRIVE_SET,
    GEAR_HAS_BRAKE_SET, GEAR_NO_BRAKE_SET,
    GEAR_P_SET, GEAR_D_SET, GEAR_R_SET,
    GEAR_DRIVE_SET, GEAR_COAST_SET,
    GEAR_REGEN_TYPICAL_SET, GEAR_STATIC_SET,
    GEAR_MOVING_SET, GEAR_BRAKE_SET,
    GEAR_ALL_VALUES, GEAR_DEFAULT,
    GEAR_ACTIVE_SET, GEAR_BRAKE_ACTIVE,
    MSTATE_GEN, MSTATE_CONSUME, MSTATE_OFF,
    SBP_ACTIVE, SBP_INACTIVE,
    RSTATE_EV,
    SPEED_STATIC, SPEED_CREEP, SPEED_LOW,
    SPEED_MEDIUM, SPEED_HIGH, SPEED_VERY_HIGH,
    SOC_CRITICAL_LOW, SOC_LOW_ZONE,
    SOC_HIGH_ZONE, SOC_FULL_ZONE,
    MIN_CHARGE_CURRENT_ABS,
    DISCHARGE_CURRENT_HIGH, DISCHARGE_CURRENT_WARNING,
    SLOW_CHARGE_POWER_MAX, FAST_CHARGE_POWER_MIN,
    GREY_CHARGE_POWER_LOW, GREY_CHARGE_POWER_HIGH,
    REGEN_SPEED_MIN,
    FIELD_DEFAULTS,
)


# ═══════════════════════════════════════════════════════════════
# 内部工具
# ═══════════════════════════════════════════════════════════════

def _safe_str(df, col, default=''):
    if col in df.columns:
        return df[col].fillna(default).astype(str).str.strip()
    print(f"[WARN] 字段'{col}'不存在，用'{default}'填充")
    return pd.Series(default, index=df.index, dtype=str)


def _safe_num(df, col, default=0.0, keep_nan=False):
    if col in df.columns:
        s = pd.to_numeric(df[col], errors='coerce')
        return s if keep_nan else s.fillna(default)
    val = np.nan if keep_nan else default
    return pd.Series(val, index=df.index, dtype=float)


def _validate_gear(gear: pd.Series):
    unknown = set(gear.unique()) - GEAR_ALL_VALUES - {GEAR_DEFAULT, ''}
    if unknown:
        print(f"[WARN] gear发现未知值({len(unknown)}种): "
              f"{list(unknown)[:3]}...")


# ═══════════════════════════════════════════════════════════════
# 主函数
# ═══════════════════════════════════════════════════════════════

def identify_operating_scenes(df: pd.DataFrame) -> pd.DataFrame:
    """
    L1 工况识别主入口
    输入：原始DataFrame（单辆车或多辆车）
    输出：添加工况标签列后的DataFrame
    """
    df = df.sort_values(['vin', 'date', 'time']).reset_index(drop=True)

    # Step1: 字段预处理
    df, cols = _preprocess(df)

    # Step2: 功率计算
    df = _calc_power(df, cols)

    # Step3: 布尔条件
    cond = _build_conditions(df, cols)

    # Step4: 充电类型
    df = _classify_charge_type(df, cond)

    # Step5: 主工况
    df['scene_tag'] = _classify_scene_tag(df, cond, cols)

    # Step6: 辅助标签
    df['speed_level'] = _classify_speed(cols['speed'])
    df['soc_zone']    = _classify_soc(cols['soc_raw'])

    # Step7: 详细工况
    df['scene_detail'] = _classify_scene_detail(df, cond, cols)

    # Step8: 充电阶段
    df['charge_stage'] = _classify_charge_stage(df, cols)

    # Step9: 放电等级
    df['discharge_level'] = _classify_discharge_level(df, cols)

    # Step10: 风险标记
    df = _mark_flags(df, cond, cols)

    # Step11: 事件切分
    df = _split_events(df)

    return df


# ───────────────────────────────────────────────────────────────
def _preprocess(df):
    cols = {}

    # 字符串字段
    for col, default in [
        ('vstate',   VSTATE_OFF),
        ('cstate',   CSTATE_NO_CHARGE),
        ('dcstate',  DCSTATE_DISCONNECT),
        ('gear',     GEAR_DEFAULT),
        ('mstate_0', MSTATE_OFF),
        ('mstate_1', MSTATE_OFF),
        ('sbp',      SBP_INACTIVE),
        ('rstate',   RSTATE_EV),
    ]:
        cols[col] = _safe_str(df, col, default)
        df[col]   = cols[col]

    # 数值字段（填0）
    for col in ['speed', 'tbc', 'tbv', 'ad']:
        cols[col] = _safe_num(df, col, 0.0, keep_nan=False)
        df[col]   = cols[col]

    # 数值字段（保留NaN）
    for col in ['soc', 'maxt', 'mint', 'maxbuv', 'minbuv', 'inre']:
        cols[f'{col}_raw'] = _safe_num(df, col, keep_nan=True)

    cols['soc'] = cols['soc_raw'].fillna(50.0)
    _validate_gear(cols['gear'])
    return df, cols


# ───────────────────────────────────────────────────────────────
def _calc_power(df, cols):
    tbc = cols['tbc']
    tbv = cols['tbv']
    df['power_abs_w']       = (tbv * tbc.abs()).round(2)
    df['discharge_power_w'] = np.where(tbc > 0, tbv * tbc, 0.0)
    df['regen_power_w']     = np.where(tbc < 0, tbv * tbc.abs(), 0.0)
    return df


# ───────────────────────────────────────────────────────────────
def _build_conditions(df, cols):
    tbc     = cols['tbc']
    speed   = cols['speed']
    soc     = cols['soc']
    vstate  = cols['vstate']
    cstate  = cols['cstate']
    gear    = cols['gear']
    mstate0 = cols['mstate_0']
    mstate1 = cols['mstate_1']
    sbp     = cols['sbp']
    pw      = df['regen_power_w']

    c = {}

    # 速度
    c['c_static']   = speed <= SPEED_STATIC
    c['c_creep']    = (speed > SPEED_STATIC) & (speed <= SPEED_CREEP)
    c['c_moving']   = speed > REGEN_SPEED_MIN
    c['c_high_spd'] = speed > SPEED_HIGH

    # 车辆状态
    c['c_von']  = vstate == VSTATE_ON
    c['c_voff'] = vstate == VSTATE_OFF

    # cstate
    c['c_park_charge']  = cstate.isin(CSTATE_PARK_CHARGE_SET)
    c['c_drive_charge'] = cstate == CSTATE_DRIVE_CHARGE
    c['c_no_charge']    = cstate == CSTATE_NO_CHARGE
    c['c_charge_done']  = cstate == CSTATE_CHARGE_DONE
    c['c_any_charging'] = cstate.isin(CSTATE_CHARGING_SET)

    # gear
    c['c_gear_has_drive'] = gear.isin(GEAR_HAS_DRIVE_SET)
    c['c_gear_has_brake'] = gear.isin(GEAR_HAS_BRAKE_SET)
    c['c_gear_no_drive']  = gear.isin(GEAR_NO_DRIVE_SET)
    c['c_gear_no_brake']  = gear.isin(GEAR_NO_BRAKE_SET)
    c['c_gear_p']         = gear.isin(GEAR_P_SET)
    c['c_gear_d']         = gear.isin(GEAR_D_SET)
    c['c_gear_r']         = gear.isin(GEAR_R_SET)
    c['c_gear_drive']     = gear.isin(GEAR_DRIVE_SET)
    c['c_gear_coast']     = gear.isin(GEAR_COAST_SET)
    c['c_gear_regen_d']   = gear.isin(GEAR_REGEN_TYPICAL_SET)

    # mstate
    c['c_m0_gen']     = mstate0 == MSTATE_GEN
    c['c_m1_gen']     = mstate1 == MSTATE_GEN
    c['c_m0_consume'] = mstate0 == MSTATE_CONSUME
    c['c_m1_consume'] = mstate1 == MSTATE_CONSUME
    c['c_any_gen']    = c['c_m0_gen'] | c['c_m1_gen']
    c['c_any_consume']= c['c_m0_consume'] | c['c_m1_consume']

    # sbp
    c['c_sbp_active'] = sbp == SBP_ACTIVE
    c['c_sbp_off']    = sbp == SBP_INACTIVE

    # 电流
    c['c_tbc_pos']  = tbc > 0
    c['c_tbc_neg']  = tbc < -MIN_CHARGE_CURRENT_ABS
    c['c_tbc_zero'] = tbc.abs() <= MIN_CHARGE_CURRENT_ABS

    # 功率范围
    c['c_slow_power'] = pw <= SLOW_CHARGE_POWER_MAX
    c['c_fast_power'] = pw >  FAST_CHARGE_POWER_MIN
    c['c_grey_power'] = (pw > GREY_CHARGE_POWER_LOW) & \
                        (pw <= GREY_CHARGE_POWER_HIGH)

    # SOC
    c['c_soc_crit'] = soc <= SOC_CRITICAL_LOW
    c['c_soc_low']  = soc <= SOC_LOW_ZONE
    c['c_soc_high'] = soc >= SOC_HIGH_ZONE
    c['c_soc_full'] = soc >= SOC_FULL_ZONE

    # 制动综合
    c['c_brake_any'] = (
        c['c_sbp_active']   |
        c['c_gear_has_brake']|
        c['c_any_gen']      |
        c['c_gear_regen_d']
    )
    return c


# ───────────────────────────────────────────────────────────────
def _classify_charge_type(df, cond):
    c = cond

    is_regen = (
        c['c_tbc_neg'] & c['c_moving'] & c['c_brake_any']
    )
    is_fast = (
        c['c_tbc_neg'] & ~is_regen &
        c['c_static']  & c['c_fast_power'] & c['c_park_charge']
    )
    is_grey = (
        c['c_tbc_neg'] & ~is_regen & ~is_fast &
        c['c_static']  & c['c_grey_power'] & c['c_park_charge']
    )
    is_slow = (
        c['c_tbc_neg'] & ~is_regen & ~is_fast &
        c['c_static']  &
        (c['c_slow_power'] | is_grey) & c['c_park_charge']
    )
    is_drive_chg = (
        c['c_tbc_neg'] & ~is_regen & ~is_fast & ~is_slow &
        c['c_drive_charge'] & ~c['c_static']
    )

    df['charge_type'] = np.select(
        [is_regen, is_fast, is_slow, is_drive_chg],
        ['regen_braking', 'fast_charge', 'slow_charge', 'drive_charge'],
        default='no_charge'
    )
    df['is_grey_charge_zone'] = is_grey.astype(np.int8)
    return df


# ───────────────────────────────────────────────────────────────
def _classify_scene_tag(df, cond, cols):
    c     = cond
    ct    = df['charge_type']
    tbc   = cols['tbc']
    speed = cols['speed']

    is_fast      = ct == 'fast_charge'
    is_slow      = ct == 'slow_charge'
    is_drv_chg   = ct == 'drive_charge'
    is_regen     = ct == 'regen_braking'
    is_drive     = c['c_tbc_pos'] & (speed > SPEED_STATIC)
    is_rest_on   = c['c_von']  & c['c_static'] & (ct == 'no_charge')
    is_rest_off  = c['c_voff']

    return np.select(
        [is_fast, is_slow, is_drv_chg, is_regen,
         is_drive, is_rest_on, is_rest_off],
        ['fast_charge', 'slow_charge', 'drive_charge',
         'regen_braking', 'drive', 'rest_on', 'rest_off'],
        default='unknown'
    )


# ───────────────────────────────────────────────────────────────
def _classify_speed(speed):
    return np.select(
        [speed <= SPEED_STATIC,
         speed <= SPEED_CREEP,
         speed <= SPEED_LOW,
         speed <= SPEED_MEDIUM,
         speed <= SPEED_HIGH,
         speed <= SPEED_VERY_HIGH],
        ['static','creep','low','medium','high','very_high'],
        default='extreme'
    )


def _classify_soc(soc_raw):
    soc = soc_raw.fillna(-1)
    return np.select(
        [soc < 0,
         soc <= SOC_CRITICAL_LOW,
         soc <= SOC_LOW_ZONE,
         soc <= 80.0,
         soc <= SOC_HIGH_ZONE,
         soc < SOC_FULL_ZONE],
        ['unknown','critical_low','low','normal','high','near_full'],
        default='full'
    )


# ───────────────────────────────────────────────────────────────
def _classify_scene_detail(df, cond, cols):
    c     = cond
    tag   = df['scene_tag']
    tbc   = cols['tbc']
    soc   = cols['soc']
    maxt  = cols['maxt_raw'].fillna(25)
    sz    = df['soc_zone']
    sl    = df['speed_level']

    fc_full    = (tag=='fast_charge') & (soc>=SOC_FULL_ZONE)
    fc_overtemp= (tag=='fast_charge') & (maxt>40)
    fc_tail    = (tag=='fast_charge') & (soc>=95) & ~fc_full
    fc_normal  = (tag=='fast_charge') & ~fc_overtemp & ~fc_full & ~fc_tail

    sc_full    = (tag=='slow_charge') & (soc>=SOC_FULL_ZONE)
    sc_grey    = (tag=='slow_charge') & (df['is_grey_charge_zone']==1)
    sc_tail    = (tag=='slow_charge') & (soc>=95) & ~sc_full
    sc_normal  = (tag=='slow_charge') & ~sc_grey & ~sc_full & ~sc_tail

    d_crit     = (tag=='drive') & (sz=='critical_low')
    d_low      = (tag=='drive') & (sz=='low')
    d_heavy    = (tag=='drive') & (tbc>DISCHARGE_CURRENT_HIGH)
    d_vhigh    = (tag=='drive') & (sl=='very_high')
    d_high     = (tag=='drive') & (sl=='high')
    d_dual     = (tag=='drive') & c['c_m0_consume'] & c['c_m1_consume']
    d_creep    = (tag=='drive') & (sl=='creep')
    d_normal   = (tag=='drive') & ~(d_crit|d_low|d_heavy|d_vhigh|d_high|d_dual|d_creep)

    rg_comb    = (tag=='regen_braking') & c['c_sbp_active'] & c['c_any_gen']
    rg_pure    = (tag=='regen_braking') & ~c['c_sbp_active'] & c['c_any_gen']
    rg_coast   = (tag=='regen_braking') & c['c_gear_coast']
    rg_mech    = (tag=='regen_braking') & c['c_sbp_active'] & ~c['c_any_gen']

    ron_p      = (tag=='rest_on')  & c['c_gear_p']
    ron_d      = (tag=='rest_on')  & c['c_gear_d']
    roff_abn   = (tag=='rest_off') & (tbc.abs()>5)
    roff_ok    = (tag=='rest_off') & ~(tbc.abs()>5)

    conditions = [
        fc_full, fc_overtemp, fc_tail, fc_normal,
        sc_full, sc_tail, sc_grey, sc_normal,
        tag=='drive_charge',
        d_crit, d_low, d_heavy, d_vhigh, d_high, d_dual, d_creep, d_normal,
        rg_comb, rg_pure, rg_coast, rg_mech,
        ron_p, ron_d, roff_abn, roff_ok,
    ]
    choices = [
        'fast_charge_full_soc','fast_charge_overtemp',
        'fast_charge_tail','fast_charge_normal',
        'slow_charge_full_soc','slow_charge_tail',
        'slow_charge_grey_zone','slow_charge_normal',
        'drive_charge_phev',
        'drive_critical_low_soc','drive_low_soc','drive_heavy_load',
        'drive_very_high_speed','drive_high_speed',
        'drive_dual_motor','drive_creep','drive_normal',
        'regen_combined_brake','regen_pure_recovery',
        'regen_coasting','regen_mech_brake_only',
        'rest_on_p_gear','rest_on_d_gear',
        'rest_off_abnormal','rest_off_normal',
    ]
    return np.select(conditions, choices, default='unknown_detail')


# ───────────────────────────────────────────────────────────────
def _classify_charge_stage(df, cols):
    soc       = cols['soc']
    in_charge = df['scene_tag'].isin(['fast_charge','slow_charge'])
    return np.select(
        [in_charge & (soc<20),
         in_charge & (soc<80),
         in_charge & (soc<95),
         in_charge & (soc>=95)],
        ['pre_charge','bulk_charge','absorption','float_charge'],
        default='not_charging'
    )


def _classify_discharge_level(df, cols):
    tbc        = cols['tbc']
    is_driving = df['scene_tag'] == 'drive'
    return np.select(
        [is_driving & (tbc>DISCHARGE_CURRENT_HIGH),
         is_driving & (tbc>DISCHARGE_CURRENT_WARNING),
         is_driving & (tbc>0)],
        ['high','medium','normal'],
        default='none'
    )


# ───────────────────────────────────────────────────────────────
def _mark_flags(df, cond, cols):
    c    = cond
    tbc  = cols['tbc']
    soc  = cols['soc']
    maxt = cols['maxt_raw'].fillna(25)
    tag  = df['scene_tag']

    flag_defs = {
        'flag_low_soc_high_discharge':
            c['c_soc_low'] & c['c_tbc_pos'] & (tbc>DISCHARGE_CURRENT_HIGH),
        'flag_critical_low_soc_drive':
            (tag=='drive') & c['c_soc_crit'],
        'flag_charge_tail':
            tag.isin(['fast_charge','slow_charge']) & (soc>=95),
        'flag_full_charge':
            tag.isin(['fast_charge','slow_charge']) & c['c_soc_full'],
        'flag_fast_charge_overtemp':
            (tag=='fast_charge') & (maxt>40),
        'flag_regen_braking':
            tag=='regen_braking',
        'flag_mech_brake_only':
            (tag=='regen_braking') & c['c_sbp_active'] & ~c['c_any_gen'],
        'flag_high_speed_high_discharge':
            c['c_high_spd'] & (tbc>DISCHARGE_CURRENT_HIGH),
        'flag_critical_off_discharge':
            c['c_voff'] & (tbc>10),
        'flag_rest_on_abnormal_current':
            (tag=='rest_on') & (tbc.abs()>5),
        'flag_dcdc_working':
            df['dcstate']==DCSTATE_WORK,
        'flag_charge_done_state':
            c['c_charge_done'],
        'flag_overcharge_risk':
            c['c_charge_done'] & c['c_tbc_neg'],
    }
    for name, condition in flag_defs.items():
        df[name] = condition.astype(np.int8)

    df['flag_grey_charge_zone'] = df['is_grey_charge_zone'].copy()
    return df


# ───────────────────────────────────────────────────────────────
def _split_events(df):
    vin_chg   = df['vin'] != df['vin'].shift(1)
    scene_chg = df['scene_tag'] != df['scene_tag'].shift(1)
    df['event_id'] = (vin_chg | scene_chg).cumsum().astype(np.int32)
    return df


# ═══════════════════════════════════════════════════════════════
# 充电事件提取（供charge_risk.py调用）
# ═══════════════════════════════════════════════════════════════

def get_charge_events(df: pd.DataFrame) -> pd.DataFrame:
    """提取充电事件汇总表"""
    df_chg = df[df['charge_type'].isin(
        ['fast_charge','slow_charge']
    )].copy()

    if df_chg.empty:
        return pd.DataFrame()

    # 计算压差（若有单体电压字段）
    if 'maxbuv' in df_chg.columns and 'minbuv' in df_chg.columns:
        df_chg['volt_diff'] = (
            df_chg['maxbuv'].fillna(0) - df_chg['minbuv'].fillna(0)
        )

    agg_dict = {
        'charge_type':        ('charge_type',        'first'),
        'date':               ('date',               'first'),
        'soc_start':          ('soc',                'first'),
        'soc_end':            ('soc',                'last'),
        'current_abs_mean':   ('tbc',                lambda x: x.abs().mean()),
        'current_abs_max':    ('tbc',                lambda x: x.abs().max()),
        'power_mean_w':       ('regen_power_w',      'mean'),
        'power_max_w':        ('regen_power_w',      'max'),
        'duration_records':   ('tbc',                'count'),
        'in_grey_zone':       ('is_grey_charge_zone','max'),
    }
    if 'maxt' in df_chg.columns:
        agg_dict['max_temp'] = ('maxt', 'max')
    if 'volt_diff' in df_chg.columns:
        agg_dict['max_volt_diff'] = ('volt_diff', 'max')
        agg_dict['end_volt_diff'] = ('volt_diff', 'last')

    result = df_chg.groupby(
        ['vin','event_id'], sort=False
    ).agg(**agg_dict).reset_index()

    return result
