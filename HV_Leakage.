"""
battery_risk/utils.py
通用工具函数
"""

import numpy as np
import pandas as pd


def safe_str_col(df: pd.DataFrame, col: str,
                 default: str = '') -> pd.Series:
    """安全获取字符串列，缺失列返回默认值Series"""
    if col in df.columns:
        null_ratio = df[col].isnull().mean()
        if null_ratio > 0.3:
            print(f"[WARN] 字段'{col}'空值率{null_ratio:.1%}，"
                  f"用'{default}'填充")
        return df[col].fillna(default).astype(str).str.strip()
    print(f"[WARN] 字段'{col}'不存在，全部用'{default}'")
    return pd.Series(default, index=df.index, dtype=str)


def safe_num_col(df: pd.DataFrame, col: str,
                 default: float = 0.0,
                 keep_nan: bool = False) -> pd.Series:
    """安全获取数值列"""
    if col in df.columns:
        s = pd.to_numeric(df[col], errors='coerce')
        return s if keep_nan else s.fillna(default)
    val = np.nan if keep_nan else default
    return pd.Series(val, index=df.index, dtype=float)


def rolling_slope(series: pd.Series, window: int) -> pd.Series:
    """滚动线性回归斜率"""
    def _slope(x):
        if x.isna().any():
            return np.nan
        return np.polyfit(range(len(x)), x, 1)[0]
    return series.rolling(window, min_periods=window).apply(
        _slope, raw=False
    )


def ratio_clip(series: pd.Series,
               scale: float = 1.0,
               lo: float = 0.0,
               hi: float = 1.0) -> float:
    """计算True/非零比例并缩放后截断"""
    r = float(series.mean()) * scale
    return float(np.clip(r, lo, hi))


def score_merge(*weighted_pairs) -> float:
    """
    加权合并多个子分
    用法：score_merge((score1, w1), (score2, w2), ...)
    """
    total_w = sum(w for _, w in weighted_pairs)
    if total_w == 0:
        return 0.0
    s = sum(v * w for v, w in weighted_pairs) / total_w
    return float(np.clip(s, 0.0, 1.0))
