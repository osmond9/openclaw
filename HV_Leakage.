    参数：
        data_path      : parquet文件路径
        output_path    : 结果CSV输出路径
        vin_batch_size : 每批处理车辆数（根据内存调整）
        verbose        : 是否打印详细日志
    """

    def __init__(
        self,
        data_path:      str,
        output_path:    str  = OUTPUT_RISK_PATH,
        vin_batch_size: int  = 2,
        verbose:        bool = True,
    ):
        self.data_path      = data_path
        self.output_path    = output_path
        self.vin_batch_size = vin_batch_size
        self.verbose        = verbose
        self.all_results    = []
        self.failed_vins    = []

        os.makedirs(os.path.dirname(output_path), exist_ok=True)
        os.makedirs(FIGURE_DIR, exist_ok=True)

    # ──────────────────────────────────────────────────────────
    def run(self) -> pd.DataFrame:
        """主运行入口，返回最终结果DataFrame"""
        t0    = time.time()
        vins  = self._get_all_vins()
        total = len(vins)

        if self.verbose:
            print(f"[INFO] 共发现 {total} 辆车，"
                  f"每批处理 {self.vin_batch_size} 辆")

        # 按批次处理
        batches = [
            vins[i:i + self.vin_batch_size]
            for i in range(0, total, self.vin_batch_size)
        ]

        for b_idx, batch_vins in enumerate(batches):
            t_batch = time.time()
            if self.verbose:
                print(f"\n[INFO] 批次 {b_idx+1}/{len(batches)}: "
                      f"{batch_vins}")

            try:
                df_batch = self._load_batch(batch_vins)
                self._process_batch(df_batch, batch_vins)
                del df_batch
                gc.collect()
            except Exception as e:
                print(f"[ERROR] 批次 {b_idx+1} 加载失败: {e}")
                traceback.print_exc()
                for v in batch_vins:
                    self.failed_vins.append(v)
                continue

            elapsed = time.time() - t_batch
            done    = (b_idx + 1) * self.vin_batch_size
            if self.verbose:
                print(f"[INFO] 批次耗时 {elapsed:.1f}s，"
                      f"累计完成 {min(done,total)}/{total}")

        return self._finalize(time.time() - t0)

    # ──────────────────────────────────────────────────────────
    def _get_all_vins(self) -> list:
        """只读vin列，获取全部车辆列表"""
        pf   = pq.ParquetFile(self.data_path)
        vins = set()
        for batch in pf.iter_batches(columns=['vin'], batch_size=500_000):
            df_tmp = batch.to_pandas()
            vins.update(df_tmp['vin'].dropna().unique().tolist())
            del df_tmp
        vins = sorted(vins)
        if self.verbose:
            print(f"[INFO] 扫描完成，共 {len(vins)} 辆车")
        return vins

    # ──────────────────────────────────────────────────────────
    def _load_batch(self, batch_vins: list) -> pd.DataFrame:
        """使用pyarrow filters只加载指定VIN的数据"""
        filters = [('vin', 'in', batch_vins)]
        df = pd.read_parquet(
            self.data_path,
            filters=filters,
            engine='pyarrow',
        )
        if self.verbose:
            mem_gb = df.memory_usage(deep=True).sum() / 1024**3
            print(f"[INFO] 批次加载: {len(df):,} 条, "
                  f"内存: {mem_gb:.2f} GB")
        return df

    # ──────────────────────────────────────────────────────────
    def _process_batch(self, df_batch: pd.DataFrame,
                       batch_vins: list):
        """逐辆处理批次内车辆"""
        for vin in batch_vins:
            t_vin  = time.time()
            df_vin = df_batch[df_batch['vin'] == vin].copy()

            if len(df_vin) == 0:
                print(f"[WARN] VIN={vin} 无数据，跳过")
                continue

            try:
                result = self._process_single_vin(vin, df_vin)
                self.all_results.append(result)
                elapsed = time.time() - t_vin
                if self.verbose:
                    print(f"  ✓ VIN={vin:<20} "
                          f"{len(df_vin):>8,}条  "
                          f"综合分={result['final_risk_score']:.4f}  "
                          f"等级={result['risk_level_cn']}  "
                          f"耗时={elapsed:.1f}s")
            except Exception as e:
                print(f"  ✗ VIN={vin} 处理失败: {e}")
                traceback.print_exc()
                self.failed_vins.append(vin)
            finally:
                del df_vin
                gc.collect()

    # ──────────────────────────────────────────────────────────
    def _process_single_vin(self, vin: str,
                             df_vin: pd.DataFrame) -> dict:
        """单辆车完整风险评估流程"""

        # ── L1 工况识别 ──────────────────────────────────────
        df_vin = identify_operating_scenes(df_vin)

        # ── L2 各维度风险评分 ────────────────────────────────
        volt_res   = calc_voltage_risk(df_vin)
        temp_res   = calc_temperature_risk(df_vin)
        charge_res = calc_charge_risk(df_vin)
        load_res   = calc_load_risk(df_vin)
        fault_res  = calc_fault_risk(df_vin)

        # 提取各子分（兼容返回dict或DataFrame）
        def _get(res, key, default=0.0):
            if isinstance(res, dict):
                return float(res.get(key, default))
            elif isinstance(res, pd.DataFrame) and len(res) > 0:
                return float(res[key].iloc[0]) if key in res.columns else default
            return default

        sub_scores = {
            'volt_risk_score':   _get(volt_res,   'volt_risk_score'),
            'temp_risk_score':   _get(temp_res,   'temp_risk_score'),
            'charge_risk_score': _get(charge_res, 'charge_risk_score'),
            'load_risk_score':   _get(load_res,   'load_risk_score'),
            'fault_risk_score':  _get(fault_res,  'fault_risk_score'),
        }

        # ── L3 融合 ──────────────────────────────────────────
        final_score, level, escalated = self._fuse(sub_scores)

        return {
            'vin':              vin,
            'record_count':     len(df_vin),
            'final_risk_score': round(final_score, 6),
            'risk_level':       level,
            'risk_level_cn':    RISK_LEVEL_CN[level],
            'risk_level_code':  RISK_LEVEL_CODE[level],
            'action':           RISK_LEVEL_ACTION[level],
            'rule_escalated':   int(escalated),
            **{k: round(v, 6) for k, v in sub_scores.items()},
        }

    # ──────────────────────────────────────────────────────────
    @staticmethod
    def _fuse(sub_scores: dict):
        """
        L3 加权融合 + 规则升档

        返回：(final_score, level, rule_escalated)
        """
        # 加权求和
        score = sum(
            sub_scores.get(k, 0.0) * w
            for k, w in FUSION_WEIGHTS.items()
        )
        score = float(np.clip(score, 0.0, 1.0))

        # 规则升档：任意子项超过阈值 → 强制至少Medium
        rule_escalated = any(
            v > RULE_ESCALATE_THRESHOLD
            for v in sub_scores.values()
        )
        if rule_escalated and score < 0.31:
            score = 0.31

        # 等级判定
        level = 'Low'
        for threshold, lv in RISK_LEVEL_THRESHOLDS:
            if score <= threshold:
                level = lv
                break

        return score, level, rule_escalated

    # ──────────────────────────────────────────────────────────
    def _finalize(self, total_elapsed: float) -> pd.DataFrame:
        """汇总结果，保存CSV，打印统计"""
        if not self.all_results:
            print("[ERROR] 无任何结果，请检查数据和代码")
            return pd.DataFrame()

        result_df = pd.DataFrame(self.all_results)
        result_df = result_df.sort_values(
            'final_risk_score', ascending=False
        ).reset_index(drop=True)

        result_df.to_csv(self.output_path, index=False,
                         encoding='utf-8-sig')

        if self.verbose:
            print(f"\n{'='*60}")
            print(f"[INFO] Pipeline完成，总耗时 "
                  f"{total_elapsed/60:.1f} 分钟")
            print(f"[INFO] 成功: {len(self.all_results)} 辆  "
                  f"失败: {len(self.failed_vins)} 辆")
            print(f"[INFO] 结果已保存: {self.output_path}")
            if self.failed_vins:
                print(f"[WARN] 失败车辆: {self.failed_vins}")

        return result_df
