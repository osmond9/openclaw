"""
battery_risk/modules/charge_risk.py
L2c 充电行为风险评分
"""

import numpy as np
import pandas as pd

from battery_risk.config import (
    CSTATE_CHARGE_DONE, CSTATE_PARK_CHARGE_SET,
    CHARGE_SOC_START_LOW, CHARGE_SOC_END_HIGH,
    CHARGE_TEMP_MAX, VOLT_DIFF_CHARGE_END,
    SLOW_CHARGE_POWER_MAX, FAST_CHARGE_POWER_MIN,
    SOC_HIGH_ZONE, SOC_FULL_ZONE,
    TEMP_MAX_WARNING,
    MIN_CHARGE_CURRENT_ABS,
)
from battery_risk.modules.operating_scene import get_charge_events


def calc_charge_risk(df: pd.DataFrame) -> dict:
    """
    充电行为风险评分主入口
    输入：单辆车已完成工况识别的DataFrame
    输出：{'charge_risk_score': float, ...}
    """
    if df.empty:
        return _zero_result()

    charge_events = get_charge_events(df)

    if charge_events.empty:
        # 无充电记录，检查高SOC停置
        high_soc_r = _calc_high_soc_park_risk(df)
        return {**_zero_result(), 'high_soc_park_risk': high_soc_r}

    ev = charge_events.copy()
    ev['is_fast'] = (ev['charge_type'] == 'fast_charge').astype(int)
    ev['is_slow'] = (ev['charge_type'] == 'slow_charge').astype(int)
    ev['chg_weight'] = np.where(ev['is_fast']==1, 1.4, 1.0)

    # 充电完成停留
    done_records = int(
        (df.get('cstate', pd.Series('', index=df.index)) == CSTATE_CHARGE_DONE
         ).sum()
    )

    # ── 单事件评分 ───────────────────────────────────────────
    ev = _score_events(ev)

    # ── VIN级聚合 ────────────────────────────────────────────
    charge_event_cnt = len(ev)
    fast_charge_cnt  = int(ev['is_fast'].sum())
    slow_charge_cnt  = int(ev['is_slow'].sum())
    full_charge_cnt  = int((ev['soc_end'].fillna(0) >= SOC_FULL_ZONE).sum())
    overtemp_cnt     = int(ev.get('r_overtemp', pd.Series(0)).sum())

    risk_mean = float(ev['event_risk'].mean())
    risk_max  = float(ev['event_risk'].max())

    fast_charge_ratio = fast_charge_cnt / max(charge_event_cnt, 1)

    # 基础充电风险
    charge_risk_base = float(np.clip(
        risk_mean * 0.5 + risk_max * 0.5, 0, 1
    ))

    # 高SOC停置风险
    high_soc_park_risk = _calc_high_soc_park_risk(df)

    # 充电完成停留风险
    charge_done_risk = float(np.clip(done_records / 100, 0, 0.3))

    # 最终得分
    charge_risk_score = float(np.clip(
        charge_risk_base   * 0.75 +
        high_soc_park_risk * 0.15 +
        charge_done_risk   * 0.10,
        0, 1
    ))

    return {
        'charge_risk_score':   charge_risk_score,
        'charge_risk_base':    round(charge_risk_base,    4),
        'high_soc_park_risk':  round(high_soc_park_risk,  4),
        'charge_done_risk':    round(charge_done_risk,     4),
        'charge_event_cnt':    charge_event_cnt,
        'fast_charge_cnt':     fast_charge_cnt,
        'slow_charge_cnt':     slow_charge_cnt,
        'full_charge_cnt':     full_charge_cnt,
        'overtemp_cnt':        overtemp_cnt,
        'fast_charge_ratio':   round(fast_charge_ratio, 4),
        'charge_risk_mean':    round(risk_mean,          4),
        'charge_risk_max':     round(risk_max,           4),
    }


# ───────────────────────────────────────────────────────────────
def _score_events(ev: pd.DataFrame) -> pd.DataFrame:
    """对每个充电事件打分"""
    soc_s = ev['soc_start'].fillna(50)
    soc_e = ev['soc_end'].fillna(0)

    # ① 低SOC起充（深放后快充，极化损伤大）
    ev['r_low_soc_start'] = (soc_s < CHARGE_SOC_START_LOW).astype(int)

    # ② 满充（SOC≥98%，长期满充加速正极老化）
    ev['r_full_charge'] = (soc_e >= SOC_FULL_ZONE).astype(int)

    # ③ 高SOC区充电（起点≥90%继续充电）
    ev['r_high_soc_continued'] = (
        (soc_s >= SOC_HIGH_ZONE) & (soc_e >= SOC_HIGH_ZONE)
    ).astype(int)

    # ④ 充电功率超额
    if 'power_max_w' in ev.columns:
        power_limit = np.where(
            ev['is_fast']==1,
            FAST_CHARGE_POWER_MIN * 1.5,   # 快充>15kW
            SLOW_CHARGE_POWER_MAX * 1.2,   # 慢充>8.4kW
        )
        over_ratio = np.clip(
            (ev['power_max_w'].fillna(0) - power_limit) /
            np.maximum(power_limit, 1), 0, 1
        )
        ev['r_overpower'] = (over_ratio * 0.15).clip(0, 0.15)
    else:
        ev['r_overpower'] = 0.0

    # ⑤ 充电温度过高
    if 'max_temp' in ev.columns:
        temp_over = (ev['max_temp'].fillna(0) - CHARGE_TEMP_MAX).clip(lower=0)
        ev['r_overtemp']    = (ev['max_temp'].fillna(0) > CHARGE_TEMP_MAX).astype(int)
        ev['r_overtemp_val'] = np.clip(temp_over / 10.0, 0, 0.20)
    else:
        ev['r_overtemp']     = 0
        ev['r_overtemp_val'] = 0.0

    # ⑥ 充电末段压差
    if 'max_volt_diff' in ev.columns:
        vd_over = (ev['max_volt_diff'].fillna(0) - VOLT_DIFF_CHARGE_END).clip(lower=0)
        ev['r_volt_diff'] = np.clip(vd_over / 0.10, 0, 0.15)
    else:
        ev['r_volt_diff'] = 0.0

    # ⑦ 灰色区间
    if 'in_grey_zone' in ev.columns:
        ev['r_grey_zone'] = (ev['in_grey_zone'] > 0).astype(int) * 0.05
    else:
        ev['r_grey_zone'] = 0.0

    # 单事件原始得分
    ev['event_risk_raw'] = (
        ev['r_low_soc_start']      * 0.20 +
        ev['r_full_charge']        * 0.15 +
        ev['r_high_soc_continued'] * 0.10 +
        ev['r_overpower']                  +
        ev['r_overtemp_val']               +
        ev['r_volt_diff']                  +
        ev['r_grey_zone']
    )

    # 快充权重加成
    ev['event_risk'] = (
        ev['event_risk_raw'] * ev['chg_weight']
    ).clip(0, 1)

    return ev


# ───────────────────────────────────────────────────────────────
def _calc_high_soc_park_risk(df: pd.DataFrame) -> float:
    """高SOC停置风险"""
    if 'soc' not in df.columns or 'scene_tag' not in df.columns:
        return 0.0
    park_high = (
        df['scene_tag'].isin(['rest_on','rest_off']) &
        (pd.to_numeric(df['soc'], errors='coerce').fillna(0) >= SOC_HIGH_ZONE)
    )
    return float(np.clip(park_high.sum() / 100, 0, 1))


def _zero_result():
    return {
        'charge_risk_score':   0.0,
        'charge_risk_base':    0.0,
        'high_soc_park_risk':  0.0,
        'charge_done_risk':    0.0,
        'charge_event_cnt':    0,
        'fast_charge_cnt':     0,
        'slow_charge_cnt':     0,
        'full_charge_cnt':     0,
        'overtemp_cnt':        0,
        'fast_charge_ratio':   0.0,
        'charge_risk_mean':    0.0,
        'charge_risk_max':     0.0,
    }
