"""
battery_risk/modules/temperature_risk.py
L2b 温度风险评分
"""

import numpy as np
import pandas as pd

from battery_risk.config import (
    TEMP_MAX_THRESHOLD, TEMP_MAX_ALARM, TEMP_MAX_WARNING,
    TEMP_MIN_THRESHOLD, TEMP_MIN_COLD,
    TEMP_DIFF_ALARM, TEMP_DIFF_WARNING, TEMP_DIFF_THRESHOLD,
    TEMP_RISE_RATE_ALARM, TEMP_RISE_RATE_WARN,
    TEMP_WINDOW, HOT_PROBE_REPEAT_TH,
    STATIC_TEMP_RISE_TH, CHARGE_TEMP_RISE_RATE, CHARGE_TEMP_MAX,
    CSTATE_CHARGING_SET,
)


def calc_temperature_risk(df: pd.DataFrame) -> dict:
    """
    温度风险评分主入口
    输入：单辆车已完成工况识别的DataFrame
    输出：{'temp_risk_score': float, ...}
    """
    if df.empty or 'maxt' not in df.columns:
        return _zero_result()

    maxt  = pd.to_numeric(df['maxt'], errors='coerce')
    mint  = pd.to_numeric(df.get('mint', pd.Series(np.nan, index=df.index)),
                          errors='coerce')
    maxtn = df.get('maxtn', None)

    tag    = df.get('scene_tag',  pd.Series('unknown', index=df.index))
    cstate = df.get('cstate',     pd.Series('未充电状态', index=df.index))

    n_total = len(df)
    if n_total == 0:
        return _zero_result()

    # ── 子项1: 最高温度超限 ──────────────────────────────────
    severe_hot   = (maxt > TEMP_MAX_ALARM)
    alarm_hot    = (maxt > TEMP_MAX_THRESHOLD)
    warning_hot  = (maxt > TEMP_MAX_WARNING)
    persist_hot  = (
        alarm_hot.rolling(TEMP_WINDOW, min_periods=1).sum() >=
        TEMP_WINDOW * 0.5
    )
    s_high_temp = float(np.clip(
        severe_hot.mean()   * 1.0 +
        alarm_hot.mean()    * 0.6 +
        warning_hot.mean()  * 0.3 +
        persist_hot.mean()  * 0.4,
        0, 1
    ))

    # ── 子项2: 最低温度超限 ──────────────────────────────────
    if not mint.isna().all():
        cold_flag       = (mint < TEMP_MIN_THRESHOLD)
        very_cold_flag  = (mint < -10.0)
        cold_charge     = cold_flag & cstate.isin(CSTATE_CHARGING_SET)
        s_low_temp = float(np.clip(
            cold_flag.mean()       * 0.3 +
            very_cold_flag.mean()  * 0.5 +
            cold_charge.mean()     * 0.7,
            0, 1
        ))
    else:
        s_low_temp = 0.0

    # ── 子项3: 温差过大 ──────────────────────────────────────
    if not mint.isna().all():
        temp_diff     = maxt - mint
        alarm_diff    = (temp_diff > TEMP_DIFF_ALARM)
        warning_diff  = (temp_diff > TEMP_DIFF_WARNING)
        drive_hi_diff = alarm_diff & (tag=='drive')
        s_temp_diff = float(np.clip(
            alarm_diff.mean()    * 0.4 +
            warning_diff.mean()  * 0.2 +
            drive_hi_diff.mean() * 0.4,
            0, 1
        ))
    else:
        s_temp_diff = 0.0

    # ── 子项4: 温升速率 ──────────────────────────────────────
    temp_rise = maxt.diff().fillna(0)

    drive_mask  = tag == 'drive'
    charge_mask = cstate.isin(CSTATE_CHARGING_SET)
    static_mask = tag.isin(['rest_on','rest_off'])

    def _rate_score(mask, threshold):
        if mask.sum() < 5:
            return 0.0
        return float((temp_rise[mask] > threshold).mean())

    alarm_drive   = _rate_score(drive_mask,  TEMP_RISE_RATE_ALARM)
    alarm_charge  = _rate_score(charge_mask, CHARGE_TEMP_RISE_RATE)
    alarm_static  = _rate_score(static_mask, 1.0)

    s_rise_rate = float(np.clip(
        alarm_drive  * 0.4 +
        alarm_charge * 0.4 +
        alarm_static * 0.5,
        0, 1
    ))

    # ── 子项5: 静置温升（最危险信号）────────────────────────
    s_static_rise = 0.0
    if static_mask.sum() > 10:
        static_maxt = maxt[static_mask].dropna()
        if len(static_maxt) > 5:
            total_rise = float(static_maxt.max() - static_maxt.min())
            s_static_rise = float(np.clip(
                total_rise / STATIC_TEMP_RISE_TH * 0.5, 0, 1
            ))
            # 趋势斜率加权
            try:
                slope = np.polyfit(
                    range(len(static_maxt)), static_maxt.values, 1
                )[0]
                if slope > 0.1:
                    s_static_rise = float(np.clip(
                        s_static_rise + 0.3, 0, 1
                    ))
            except Exception:
                pass

    # ── 子项6: 固定热点探针 ──────────────────────────────────
    s_hot_probe = 0.0
    if maxtn is not None:
        valid_maxtn = maxtn.dropna()
        if len(valid_maxtn) > 10:
            freq = valid_maxtn.value_counts(normalize=True)
            max_freq = float(freq.iloc[0]) if len(freq) > 0 else 0.0
            # 超过50%固定→局部热点
            s_hot_probe = float(np.clip(
                max(0, max_freq - 0.5) * 2.0, 0, 1
            ))

    # ── 综合得分 ─────────────────────────────────────────────
    temp_risk_score = float(np.clip(
        s_high_temp   * 0.30 +
        s_temp_diff   * 0.25 +
        s_rise_rate   * 0.20 +
        s_static_rise * 0.15 +
        s_low_temp    * 0.05 +
        s_hot_probe   * 0.05,
        0, 1
    ))

    return {
        'temp_risk_score':         temp_risk_score,
        'temp_high_score':         round(s_high_temp,   4),
        'temp_low_score':          round(s_low_temp,    4),
        'temp_diff_score':         round(s_temp_diff,   4),
        'temp_rise_rate_score':    round(s_rise_rate,   4),
        'temp_static_rise_score':  round(s_static_rise, 4),
        'temp_hot_probe_score':    round(s_hot_probe,   4),
        'maxt_mean':               round(float(maxt.mean()), 2),
        'maxt_max':                round(float(maxt.max()),  2),
    }


def _zero_result():
    return {
        'temp_risk_score':        0.0,
        'temp_high_score':        0.0,
        'temp_low_score':         0.0,
        'temp_diff_score':        0.0,
        'temp_rise_rate_score':   0.0,
        'temp_static_rise_score': 0.0,
        'temp_hot_probe_score':   0.0,
        'maxt_mean':              0.0,
        'maxt_max':               0.0,
    }
