"""
battery_risk/modules/fusion.py
L3 综合融合模块（独立函数版，也可被pipeline直接调用）
"""

import numpy as np

from battery_risk.config import (
    FUSION_WEIGHTS,
    RULE_ESCALATE_THRESHOLD,
    RISK_LEVEL_THRESHOLDS,
    RISK_LEVEL_CN,
    RISK_LEVEL_ACTION,
    RISK_LEVEL_CODE,
)


def fuse_risk_scores(
    volt_risk_score:   float,
    temp_risk_score:   float,
    charge_risk_score: float,
    load_risk_score:   float,
    fault_risk_score:  float,
    vin:               str = '',
) -> dict:
    """
    L3 加权融合 + 规则升档

    输入：5个子维度风险分（0~1）
    输出：融合结果字典

    算法：
    1. 加权求和（权重见FUSION_WEIGHTS）
    2. 规则升档：任意子分>0.75 → 强制final_score≥0.31（至少Medium）
    3. 等级判定：[0,0.3]→Low, (0.3,0.6]→Medium, (0.6,1.0]→High, >1.0→Critical
    """
    sub_scores = {
        'volt_risk_score':   max(0.0, min(1.0, float(volt_risk_score))),
        'temp_risk_score':   max(0.0, min(1.0, float(temp_risk_score))),
        'charge_risk_score': max(0.0, min(1.0, float(charge_risk_score))),
        'load_risk_score':   max(0.0, min(1.0, float(load_risk_score))),
        'fault_risk_score':  max(0.0, min(1.0, float(fault_risk_score))),
    }

    # 加权求和
    weighted_sum = sum(
        sub_scores[k] * w
        for k, w in FUSION_WEIGHTS.items()
    )
    final_score = float(np.clip(weighted_sum, 0.0, 1.0))

    # 规则升档
    rule_escalated = any(
        v > RULE_ESCALATE_THRESHOLD
        for v in sub_scores.values()
    )
    if rule_escalated and final_score < 0.31:
        final_score = 0.31

    # 等级判定
    level = 'Low'
    for threshold, lv in RISK_LEVEL_THRESHOLDS:
        if final_score <= threshold:
            level = lv
            break

    return {
        'vin':              vin,
        'final_risk_score': round(final_score, 6),
        'risk_level':       level,
        'risk_level_cn':    RISK_LEVEL_CN[level],
        'risk_level_code':  RISK_LEVEL_CODE[level],
        'action':           RISK_LEVEL_ACTION[level],
        'rule_escalated':   int(rule_escalated),
        **{k: round(v, 6) for k, v in sub_scores.items()},
        'weight_volt':      FUSION_WEIGHTS['volt_risk_score'],
        'weight_temp':      FUSION_WEIGHTS['temp_risk_score'],
        'weight_charge':    FUSION_WEIGHTS['charge_risk_score'],
        'weight_load':      FUSION_WEIGHTS['load_risk_score'],
        'weight_fault':     FUSION_WEIGHTS['fault_risk_score'],
    }


def get_risk_level(score: float) -> str:
    """单独根据分数获取等级"""
    for threshold, level in RISK_LEVEL_THRESHOLDS:
        if score <= threshold:
            return level
    return 'Critical'


def explain_risk(result: dict) -> str:
    """
    生成风险解释文字（供报告使用）
    输入：fuse_risk_scores返回的字典
    """
    lines = [
        f"综合风险评分：{result['final_risk_score']:.4f}",
        f"风险等级：{result['risk_level_cn']}",
        f"处置建议：{result['action']}",
        "",
        "各维度得分：",
        f"  电压风险：{result['volt_risk_score']:.4f}  (权重 {result['weight_volt']})",
        f"  温度风险：{result['temp_risk_score']:.4f}  (权重 {result['weight_temp']})",
        f"  充电行为：{result['charge_risk_score']:.4f}  (权重 {result['weight_charge']})",
        f"  负荷风险：{result['load_risk_score']:.4f}  (权重 {result['weight_load']})",
        f"  故障风险：{result['fault_risk_score']:.4f}  (权重 {result['weight_fault']})",
    ]
    if result.get('rule_escalated'):
        lines.append("\n⚠️  已触发规则升档（某维度极端异常）")
    return '\n'.join(lines)
