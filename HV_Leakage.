"""
battery_risk/modules/fault_risk.py
L2e 故障风险评分
"""

import numpy as np
import pandas as pd

from battery_risk.config import (
    FAULT_INSULATION_LOW, FAULT_INSULATION_WARN,
    FAULT_INSULATION_SLOPE,
    HALVL_SERIOUS, BATTERY_FAULT_CNT_TH,
    MULTI_SYSTEM_FAULT_TH, FAULT_CODE_WEIGHT,
    VSTATE_OFF,
)


def calc_fault_risk(df: pd.DataFrame) -> dict:
    """
    故障风险评分主入口
    输入：单辆车已完成工况识别的DataFrame
    输出：{'fault_risk_score': float, ...}
    """
    if df.empty:
        return _zero_result()

    tbc    = pd.to_numeric(df.get('tbc',   0), errors='coerce').fillna(0)
    vstate = df.get('vstate', pd.Series(VSTATE_OFF, index=df.index))
    inre   = pd.to_numeric(
        df.get('inre', pd.Series(9999.0, index=df.index)),
        errors='coerce'
    ).fillna(9999.0)
    halvl  = pd.to_numeric(df.get('halvl', 0), errors='coerce').fillna(0)
    aobf   = pd.to_numeric(df.get('aobf',  0), errors='coerce').fillna(0)
    aodmf  = pd.to_numeric(df.get('aodmf', 0), errors='coerce').fillna(0)
    aoef   = pd.to_numeric(df.get('aoef',  0), errors='coerce').fillna(0)
    aoof   = pd.to_numeric(df.get('aoof',  0), errors='coerce').fillna(0)
    tag    = df.get('scene_tag', pd.Series('unknown', index=df.index))

    # ── 子项1: 绝缘电阻 (最重要) ─────────────────────────────
    # 过滤掉0值（传感器断开时可能为0）
    inre_valid = inre[inre > 0]

    danger_insul  = (inre < FAULT_INSULATION_LOW) & (inre > 0)
    warning_insul = (inre < FAULT_INSULATION_WARN) & (inre > 0)

    # 绝缘下降趋势
    s_trend = 0.0
    if len(inre_valid) > 30:
        try:
            slope_series = inre.rolling(30, min_periods=10).apply(
                lambda x: np.polyfit(range(len(x)), x, 1)[0]
                if (~np.isnan(x)).sum() >= 5 else 0,
                raw=True
            )
            trend_bad = (slope_series < FAULT_INSULATION_SLOPE)
            s_trend   = float(np.clip(trend_bad.mean() * 3.0, 0, 1))
        except Exception:
            pass

    s_insulation = float(np.clip(
        danger_insul.mean()  * 1.5 +    # 危险直接超满
        warning_insul.mean() * 0.4 +
        s_trend              * 0.3,
        0, 1
    ))

    # ── 子项2: 告警等级 ──────────────────────────────────────
    severe_alarm  = (halvl >= HALVL_SERIOUS)
    general_alarm = (halvl >= 1)
    persist_alarm = (
        severe_alarm.rolling(10, min_periods=1).sum() >= 3
    )
    s_alarm = float(np.clip(
        severe_alarm.mean()  * 0.6 +
        general_alarm.mean() * 0.3 +
        persist_alarm.mean() * 0.4,
        0, 1
    ))

    # ── 子项3: 故障码数量 ────────────────────────────────────
    high_fault = (aobf > BATTERY_FAULT_CNT_TH)
    any_fault  = (aobf > 0)
    s_fault_cnt = float(np.clip(
        high_fault.mean() * 0.7 +
        any_fault.mean()  * 0.3,
        0, 1
    ))

    # ── 子项4: 多系统同时故障 ────────────────────────────────
    fault_systems = (
        (aobf  > 0).astype(int) +
        (aodmf > 0).astype(int) +
        (aoef  > 0).astype(int) +
        (aoof  > 0).astype(int)
    )
    multi_fault = (fault_systems >= MULTI_SYSTEM_FAULT_TH)
    s_multi     = float(np.clip(multi_fault.mean() * 2.0, 0, 1))

    # ── 子项5: 熄火异常放电（暗电流）────────────────────────
    off_discharge   = (vstate == VSTATE_OFF) & (tbc > 10.0)
    s_off_discharge = float(np.clip(off_discharge.mean() * 5.0, 0, 1))

    # ── 子项6: 上电静置异常电流 ──────────────────────────────
    rest_abnormal = (tag == 'rest_on') & (tbc.abs() > 5.0)
    s_rest_abn    = float(np.clip(rest_abnormal.mean() * 5.0, 0, 1))

    # ── 综合得分 ─────────────────────────────────────────────
    fault_risk_score = float(np.clip(
        s_insulation    * 0.40 +
        s_alarm         * 0.30 +
        s_fault_cnt     * 0.15 +
        s_multi         * 0.10 +
        s_off_discharge * 0.03 +
        s_rest_abn      * 0.02,
        0, 1
    ))

    return {
        'fault_risk_score':         fault_risk_score,
        'fault_insulation_score':   round(s_insulation,    4),
        'fault_alarm_score':        round(s_alarm,         4),
        'fault_code_cnt_score':     round(s_fault_cnt,     4),
        'fault_multi_system_score': round(s_multi,         4),
        'fault_off_discharge_score':round(s_off_discharge, 4),
        'fault_rest_abnormal_score':round(s_rest_abn,      4),
        'inre_min':                 round(float(inre_valid.min())
                                          if len(inre_valid)>0 else 9999.0, 2),
        'inre_mean':                round(float(inre_valid.mean())
                                          if len(inre_valid)>0 else 9999.0, 2),
        'halvl_max':                int(halvl.max()),
        'aobf_max':                 int(aobf.max()),
        'danger_insul_ratio':       round(float(danger_insul.mean()), 4),
        'severe_alarm_ratio':       round(float(severe_alarm.mean()), 4),
    }


def _zero_result():
    return {
        'fault_risk_score':          0.0,
        'fault_insulation_score':    0.0,
        'fault_alarm_score':         0.0,
        'fault_code_cnt_score':      0.0,
        'fault_multi_system_score':  0.0,
        'fault_off_discharge_score': 0.0,
        'fault_rest_abnormal_score': 0.0,
        'inre_min':                  9999.0,
        'inre_mean':                 9999.0,
        'halvl_max':                 0,
        'aobf_max':                  0,
        'danger_insul_ratio':        0.0,
        'severe_alarm_ratio':        0.0,
    }
