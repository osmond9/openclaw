"""
battery_risk/modules/voltage_risk.py
L2a 电压风险评分
"""

import numpy as np
import pandas as pd

from battery_risk.config import (
    VOLT_MAX_THRESHOLD, VOLT_MIN_THRESHOLD,
    VOLT_DIFF_ALARM, VOLT_DIFF_WARNING,
    VOLT_DIFF_CHARGE_END, CHARGE_END_VOLT_DIFF,
    VOLT_WINDOW, VOLT_TREND_WINDOW,
    ABNORMAL_CELL_REPEAT_TH,
    SLOW_CHARGE_POWER_MAX, FAST_CHARGE_POWER_MIN,
    DISCHARGE_CURRENT_WARNING,
)


def calc_voltage_risk(df: pd.DataFrame) -> dict:
    """
    电压风险评分主入口
    输入：单辆车已完成工况识别的DataFrame
    输出：{'volt_risk_score': float, ...}
    """
    if df.empty:
        return _zero_result()

    # 检查必要字段
    if 'maxbuv' not in df.columns or 'minbuv' not in df.columns:
        return _zero_result()

    maxbuv = pd.to_numeric(df['maxbuv'], errors='coerce').fillna(0)
    minbuv = pd.to_numeric(df['minbuv'], errors='coerce').fillna(0)
    maxvbn = df['maxvbn'] if 'maxvbn' in df.columns else None
    minvbn = df['minvbn'] if 'minvbn' in df.columns else None

    tag   = df.get('scene_tag',  pd.Series('unknown', index=df.index))
    stage = df.get('charge_stage', pd.Series('not_charging', index=df.index))
    tbc   = pd.to_numeric(df.get('tbc', 0), errors='coerce').fillna(0)
    tbv   = pd.to_numeric(df.get('tbv', 0), errors='coerce').fillna(0)

    volt_diff = maxbuv - minbuv

    # ── 子项1: 过压 ──────────────────────────────────────────
    overvolt  = (maxbuv > VOLT_MAX_THRESHOLD)
    ov_ratio  = float(overvolt.mean())
    # 持续过压（窗口内持续）
    persist_ov = (
        overvolt.rolling(VOLT_WINDOW, min_periods=1).sum() >=
        VOLT_WINDOW * 0.5
    )
    s_overvolt = float(np.clip(
        ov_ratio * 0.5 + persist_ov.mean() * 0.5, 0, 1
    ))

    # ── 子项2: 欠压 ──────────────────────────────────────────
    undervolt = (minbuv < VOLT_MIN_THRESHOLD) & (minbuv > 0)
    uv_ratio  = float(undervolt.mean())
    # 行驶中欠压更危险
    drive_uv  = float((undervolt & (tag=='drive')).mean())
    s_undervolt = float(np.clip(
        uv_ratio * 0.4 + drive_uv * 0.6, 0, 1
    ))

    # ── 子项3: 压差 ──────────────────────────────────────────
    alarm_diff   = volt_diff > VOLT_DIFF_ALARM
    warning_diff = volt_diff > VOLT_DIFF_WARNING
    persist_diff = (
        alarm_diff.rolling(VOLT_WINDOW, min_periods=1).sum() >=
        VOLT_WINDOW * 0.5
    )
    s_diff = float(np.clip(
        alarm_diff.mean()   * 0.4 +
        warning_diff.mean() * 0.2 +
        persist_diff.mean() * 0.4,
        0, 1
    ))

    # ── 子项4: 充电末段压差 ──────────────────────────────────
    float_mask = (stage == 'float_charge')
    if float_mask.sum() > 5:
        tail_diff_alarm = (volt_diff[float_mask] > VOLT_DIFF_CHARGE_END).mean()
        s_charge_end    = float(np.clip(tail_diff_alarm * 2.0, 0, 1))
    else:
        s_charge_end = 0.0

    # ── 子项5: 固定异常单体 ──────────────────────────────────
    s_fixed = 0.0
    if maxvbn is not None and len(maxvbn.dropna()) > 10:
        freq_high = maxvbn.value_counts(normalize=True)
        max_high  = float(freq_high.iloc[0]) if len(freq_high)>0 else 0
        s_fixed  += max(0, max_high - 0.5) * 1.0   # 超过50%占比认为固定
    if minvbn is not None and len(minvbn.dropna()) > 10:
        freq_low = minvbn.value_counts(normalize=True)
        max_low  = float(freq_low.iloc[0]) if len(freq_low)>0 else 0
        s_fixed += max(0, max_low - 0.5) * 1.0
    s_fixed = float(np.clip(s_fixed, 0, 1))

    # ── 子项6: 电压趋势下降 ──────────────────────────────────
    drive_mask = tag == 'drive'
    s_trend    = 0.0
    if drive_mask.sum() > 30:
        tbv_drive = tbv[drive_mask].reset_index(drop=True)
        # 滚动斜率
        def _slope(x):
            if len(x) < 10: return 0
            return np.polyfit(range(len(x)), x, 1)[0]
        slopes = tbv_drive.rolling(
            VOLT_TREND_WINDOW, min_periods=10
        ).apply(_slope, raw=True)
        abnormal_drop = (slopes < -0.5).mean()
        s_trend = float(np.clip(abnormal_drop * 5.0, 0, 1))

    # ── 综合得分 ─────────────────────────────────────────────
    volt_risk_score = float(np.clip(
        s_overvolt   * 0.25 +
        s_undervolt  * 0.20 +
        s_diff       * 0.25 +
        s_charge_end * 0.15 +
        s_fixed      * 0.10 +
        s_trend      * 0.05,
        0, 1
    ))

    return {
        'volt_risk_score':        volt_risk_score,
        'volt_overvolt_score':    round(s_overvolt,   4),
        'volt_undervolt_score':   round(s_undervolt,  4),
        'volt_diff_score':        round(s_diff,       4),
        'volt_charge_end_score':  round(s_charge_end, 4),
        'volt_fixed_cell_score':  round(s_fixed,      4),
        'volt_trend_score':       round(s_trend,      4),
        'overvolt_ratio':         round(ov_ratio,     4),
        'undervolt_ratio':        round(uv_ratio,     4),
        'volt_diff_mean':         round(float(volt_diff.mean()), 4),
        'volt_diff_max':          round(float(volt_diff.max()),  4),
    }


def _zero_result():
    return {
        'volt_risk_score':       0.0,
        'volt_overvolt_score':   0.0,
        'volt_undervolt_score':  0.0,
        'volt_diff_score':       0.0,
        'volt_charge_end_score': 0.0,
        'volt_fixed_cell_score': 0.0,
        'volt_trend_score':      0.0,
        'overvolt_ratio':        0.0,
        'undervolt_ratio':       0.0,
        'volt_diff_mean':        0.0,
        'volt_diff_max':         0.0,
    }
