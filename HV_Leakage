# 12. L2 高负荷用车风险算法

## 📄 battery_risk/modules/load_risk.py

```python
"""
load_risk.py - L2 高负荷用车风险算法

风险识别：
  1. 低SOC大电流放电
  2. 高功率持续输出
  3. 激烈驾驶（急加减速）
  4. 电机/控制器高温
  5. 高速重载
  6. 使用强度（日均里程/时长）
  7. 双电机重载
"""

import numpy as np
import pandas as pd
from battery_risk.config import (
    LOAD_CURRENT_HIGH, LOAD_POWER_HIGH_KW,
    LOAD_SOC_LOW, LOAD_SPEED_HIGH,
    MOTOR_TEMP_HIGH, MOTOR_CTRL_TEMP_HIGH,
    HARD_ACC_THRESHOLD, HARD_BRAKE_THRESHOLD,
    FAST_CHARGE_CURRENT
)


def load_risk_enhanced(df: pd.DataFrame) -> pd.DataFrame:
    """
    高负荷风险主函数（返回带负荷风险分的DataFrame）

    输入：含 tbc, tbv, soc, speed, ad, mtor_0/1,
              mtemp_0/1, mctemp_0/1 的 DataFrame
    输出：新增 load_risk_score 及中间特征列的DataFrame
    """
    print("[INFO] 开始 L2 高负荷用车风险识别...")
    df = df.sort_values(['vin', 'date', 'time']).reset_index(drop=True)

    # ---- 仅对行驶工况计算（不影响其他工况） ----
    drive_mask = df.get('scene_tag', pd.Series('', index=df.index)).isin(
        ['drive', 'regen', 'drive_charge']
    )

    # ---------- 1. 功率特征 ----------
    df['power_kw_abs'] = df['power_kw'].abs() if 'power_kw' in df.columns \
        else (df['tbv'] * df['tbc']).abs() / 1000.0

    df['is_high_power'] = (
        drive_mask & (df['power_kw_abs'] > LOAD_POWER_HIGH_KW)
    ).astype(int)

    df['is_high_current'] = (
        drive_mask & (df['tbc'].abs() > LOAD_CURRENT_HIGH)
    ).astype(int)

    # ---------- 2. 低SOC大电流 ----------
    df['is_low_soc_high_I'] = (
        drive_mask &
        (df['soc'] < LOAD_SOC_LOW) &
        (df['tbc'].abs() > FAST_CHARGE_CURRENT)
    ).astype(int)

    # ---------- 3. 激烈驾驶 ----------
    if 'ad' in df.columns:
        df['is_hard_acc']   = (df['ad'] > HARD_ACC_THRESHOLD).astype(int)
        df['is_hard_brake'] = (df['ad'] < HARD_BRAKE_THRESHOLD).astype(int)
        df['is_aggressive_driving'] = (
            (df['is_hard_acc'] | df['is_hard_brake'])
        ).astype(int)
    else:
        df['is_hard_acc'] = df['is_hard_brake'] = df['is_aggressive_driving'] = 0

    # ---------- 4. 电机高温 ----------
    motor_temp_flag = pd.Series(False, index=df.index)
    ctrl_temp_flag  = pd.Series(False, index=df.index)

    for i in ['0', '1']:
        mt_col  = f'mtemp_{i}'
        mct_col = f'mctemp_{i}'
        if mt_col in df.columns:
            motor_temp_flag = motor_temp_flag | (df[mt_col] > MOTOR_TEMP_HIGH)
        if mct_col in df.columns:
            ctrl_temp_flag = ctrl_temp_flag | (df[mct_col] > MOTOR_CTRL_TEMP_HIGH)

    df['is_motor_over_temp']      = motor_temp_flag.astype(int)
    df['is_motor_ctrl_over_temp'] = ctrl_temp_flag.astype(int)

    # ---------- 5. 高速重载 ----------
    df['is_high_speed_load'] = (
        drive_mask &
        (df['speed'] > LOAD_SPEED_HIGH) &
        (df['power_kw_abs'] > LOAD_POWER_HIGH_KW * 0.7)
    ).astype(int)

    # ---------- 6. 双电机重载 ----------
    if 'is_dual_motor_drive' in df.columns:
        df['is_dual_motor_high_load'] = (
            (df.get('is_dual_motor_drive', 0) == 1) &
            (df['power_kw_abs'] > LOAD_POWER_HIGH_KW)
        ).astype(int)
    else:
        df['is_dual_motor_high_load'] = 0

    # ---------- 7. 滚动窗口统计 ----------
    grp = df.groupby('vin')
    W = 20

    roll_cols = [
        'is_high_power', 'is_high_current', 'is_low_soc_high_I',
        'is_aggressive_driving', 'is_motor_over_temp',
        'is_motor_ctrl_over_temp', 'is_high_speed_load',
        'is_dual_motor_high_load',
    ]
    for col in roll_cols:
        df[f'{col}_roll'] = grp[col].transform(
            lambda x: x.rolling(W, min_periods=1).sum()
        )

    # ---------- 8. 综合负荷风险评分 ----------
    score_power = (df['is_high_power_roll'] / W).clip(0, 1) * 0.6
    score_low_soc_I = (df['is_low_soc_high_I_roll'] / W).clip(0, 1) * 0.8
    score_aggressive = (df['is_aggressive_driving_roll'] / W).clip(0, 1) * 0.4
    score_motor_temp = (
        (df['is_motor_over_temp_roll'] + df['is_motor_ctrl_over_temp_roll']) / (2 * W)
    ).clip(0, 1) * 0.6
    score_high_speed = (df['is_high_speed_load_roll'] / W).clip(0, 1) * 0.4
    score_dual_load  = (df['is_dual_motor_high_load_roll'] / W).clip(0, 1) * 0.2

    df['load_risk_score'] = (
        score_power + score_low_soc_I + score_aggressive +
        score_motor_temp + score_high_speed + score_dual_load
    ).clip(0, 3.0).round(4)

    # 非行驶工况负荷分置0
    df.loc[~drive_mask, 'load_risk_score'] = 0.0

    print(f"[INFO] 负荷风险识别完成，"
          f"平均分: {df['load_risk_score'].mean():.4f}, "
          f"最大分: {df['load_risk_score'].max():.4f}")
    return df
