# 14. L3 综合风险融合算法

## 📄 battery_risk/modules/fusion.py

```python
"""
fusion.py - L3 综合风险融合算法

融合策略：
  1. 加权融合五类子风险分
  2. 规则兜底（严重单项直接升档）
  3. 车型/电池包分层校准
  4. 老化里程修正
  5. 输出风险等级 + 原因 + 建议
"""

import numpy as np
import pandas as pd
from battery_risk.config import (
    FUSION_WEIGHTS, RULE_ESCALATE_THRESHOLD,
    RISK_LEVEL_THRESHOLDS
)
from battery_risk.utils import risk_level_from_score, recommend_action, get_main_risk_reason


def final_risk_fusion_enhanced(
        df_processed: pd.DataFrame,
        charge_events: pd.DataFrame,
        load_risk_col: str = 'load_risk_score'
) -> pd.DataFrame:
    """
    综合风险融合主函数

    输入：
      df_processed  : 含各子风险分的明细DataFrame
      charge_events : 充电事件风险汇总DataFrame（可为None）
      load_risk_col : 负荷风险分列名

    输出：单车最终风险汇总DataFrame（每辆车一行）
    """
    print("[INFO] 开始 L3 综合风险融合...")

    # ---- Step 1: 按VIN聚合各子风险分 ----
    agg_cols = {}
    sub_scores = [
        'volt_risk_score', 'temp_risk_score',
        'load_risk_score', 'fault_risk_score'
    ]
    for col in sub_scores:
        if col in df_processed.columns:
            agg_cols[col] = ['mean', 'max', 'std']

    # 分层校准字段
    meta_cols = ['battery_code', 'car_type', 'project_no',
                 'ev_phev', 'purchase_date', 'mil', 'run_hour']
    for col in meta_cols:
        if col in df_processed.columns:
            agg_cols[col] = 'first'

    vin_agg = df_processed.groupby('vin').agg(agg_cols)
    vin_agg.columns = [
        '_'.join(filter(None, map(str, c))).strip('_')
        if isinstance(c, tuple) else c
        for c in vin_agg.columns
    ]
    vin_agg = vin_agg.reset_index()

    # ---- Step 2: 合并充电风险分 ----
    if charge_events is not None and not charge_events.empty and 'vin' in charge_events.columns:
        chg_agg = charge_events.groupby('vin').agg(
            charge_risk_score_mean=('charge_risk_score', 'mean'),
            charge_risk_score_max =('charge_risk_score', 'max'),
        ).reset_index()
        vin_agg = vin_agg.merge(chg_agg, on='vin', how='left')
    else:
        vin_agg['charge_risk_score_mean'] = 0.0
        vin_agg['charge_risk_score_max']  = 0.0

    vin_agg['charge_risk_score_mean'] = vin_agg['charge_risk_score_mean'].fillna(0)
    vin_agg['charge_risk_score_max']  = vin_agg['charge_risk_score_max'].fillna(0)

    # ---- Step 3: 各子分提取 ----
    def _get_col(df, col, default=0.0):
        return df.get(col, pd.Series(default, index=df.index)).fillna(default)

    volt_mean   = _get_col(vin_agg, 'volt_risk_score_mean')
    temp_mean   = _get_col(vin_agg, 'temp_risk_score_mean')
    charge_mean = _get_col(vin_agg, 'charge_risk_score_mean')
    load_mean   = _get_col(vin_agg, 'load_risk_score_mean')
    fault_mean  = _get_col(vin_agg, 'fault_risk_score_mean')

    volt_max    = _get_col(vin_agg, 'volt_risk_score_max')
    temp_max    = _get_col(vin_agg, 'temp_risk_score_max')
    fault_max   = _get_col(vin_agg, 'fault_risk_score_max')
    charge_max  = _get_col(vin_agg, 'charge_risk_score_max')
    load_max    = _get_col(vin_agg, 'load_risk_score_max')

    # ---- Step 4: 加权融合 ----
    W = FUSION_WEIGHTS
    weighted_score = (
        volt_mean   * W['volt_risk_score'] +
        temp_mean   * W['temp_risk_score'] +
        charge_mean * W['charge_risk_score'] +
        load_mean   * W['load_risk_score'] +
        fault_mean  * W['fault_risk_score']
    )

    # ---- Step 5: 规则兜底（严重单项直接升档） ----
    max_sub_score = pd.concat(
        [volt_max, temp_max, charge_max, load_max, fault_max], axis=1
    ).max(axis=1)

    rule_escalate = max_sub_score >= RULE_ESCALATE_THRESHOLD

    final_score = np.where(
        rule_escalate,
        np.maximum(weighted_score, RULE_ESCALATE_THRESHOLD),
        weighted_score
    )
    vin_agg['final_risk_score'] = pd.Series(final_score).clip(0, 3.0).round(4)

    # ---- Step 6: 风险等级 ----
    vin_agg['final_risk_level'] = vin_agg['final_risk_score'].apply(
        risk_level_from_score
    )

    # ---- Step 7: 老化修正（里程越高风险微调上升） ----
    if 'mil_first' in vin_agg.columns:
        mil = vin_agg['mil_first'].fillna(0)
        age_factor = (mil / 200000).clip(0, 0.3)   # 最多增加0.3分
        vin_agg['final_risk_score'] = (
            vin_agg['final_risk_score'] + age_factor * 0.1
        ).clip(0, 3.0).round(4)
        # 更新等级
        vin_agg['final_risk_level'] = vin_agg['final_risk_score'].apply(
            risk_level_from_score
        )

    # ---- Step 8: 主要风险原因 ----
    vin_agg['main_risk_reason'] = vin_agg.apply(
        lambda row: _get_main_reason(row), axis=1
    )
    vin_agg['recommend_action'] = vin_agg['final_risk_level'].apply(
        recommend_action
    )
    vin_agg['rule_escalated']   = rule_escalate.values

    # ---- Step 9: 最终输出字段整理 ----
    output_cols = [
        'vin',
        'volt_risk_score_mean', 'temp_risk_score_mean',
        'charge_risk_score_mean', 'load_risk_score_mean', 'fault_risk_score_mean',
        'volt_risk_score_max', 'temp_risk_score_max',
        'charge_risk_score_max', 'load_risk_score_max', 'fault_risk_score_max',
        'final_risk_score', 'final_risk_level',
        'main_risk_reason', 'recommend_action', 'rule_escalated',
    ]
    # 补充元数据列
    for col in ['battery_code_first', 'car_type_first',
                'ev_phev_first', 'purchase_date_first']:
        if col in vin_agg.columns:
            output_cols.append(col)

    avail_cols = [c for c in output_cols if c in vin_agg.columns]
    result = vin_agg[avail_cols].sort_values(
        'final_risk_score', ascending=False
    ).reset_index(drop=True)

    # ---- 打印汇总 ----
    print(f"[INFO] 综合融合完成，共 {len(result)} 辆车")
    print(f"[INFO] 风险等级分布:")
    dist = result['final_risk_level'].value_counts()
    for k, v in dist.items():
        print(f"       {k}: {v} 辆 ({v/len(result)*100:.1f}%)")

    return result


def _get_main_reason(row: pd.Series) -> str:
    """找出风险最高的子模块作为主因"""
    candidates = {
        '电压一致性异常': row.get('volt_risk_score_mean', 0),
        '温度/热风险':    row.get('temp_risk_score_mean', 0),
        '充电行为异常':   row.get('charge_risk_score_mean', 0),
        '高负荷用车':     row.get('load_risk_score_mean', 0),
        '故障/绝缘异常':  row.get('fault_risk_score_mean', 0),
    }
    max_score = max(candidates.values())
    if max_score < 0.05:
        return '无明显异常'
    return max(candidates, key=candidates.get)
