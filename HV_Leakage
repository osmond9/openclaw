# 8. L1 工况识别算法

## 📄 battery_risk/modules/operating_scene.py

```python
"""
operating_scene.py - L1 工况识别算法（深度重构版）

字段含义：
  vstate   : 0=熄火, 1=启动/上电
  cstate   : 0=未充电, 1=停车充电, 2=行驶充电
  rstate   : 1=纯电模式
  dcstate  : 0=断开, 1=工作/连接
  gear     : 0=P挡(无驱无制), 1=D挡(有驱无制),
             2=D挡(无驱有制/制动), 3=倒挡/滑行
  sbp      : 0=制动关, >0=制动有效
  mstate_0 : 0=关闭, 1=耗电/驱动, 2=发电/回收
  mstate_1 : 0=关闭, 1=耗电/驱动, 2=发电/回收
"""

import numpy as np
import pandas as pd
from battery_risk.config import (
    SPEED_STATIC, SPEED_LOW, SPEED_MEDIUM,
    SPEED_HIGH, SPEED_VERY_HIGH,
    SOC_LOW_ZONE, SOC_HIGH_ZONE,
    SOC_CRITICAL_LOW, SOC_FULL,
    CURRENT_CHARGE_MIN, FAST_CHARGE_CURRENT,
    TEMP_HIGH_WARNING
)

# ============================================================
# 状态常量定义
# ============================================================
VSTATE_OFF = 0
VSTATE_ON  = 1

CSTATE_NO_CHARGE    = 0
CSTATE_PARK_CHARGE  = 1
CSTATE_DRIVE_CHARGE = 2

RSTATE_EV = 1

DCSTATE_DISCONNECT = 0
DCSTATE_CONNECTED  = 1

GEAR_P       = 0   # P挡：无驱动力无制动力停车
GEAR_D_DRIVE = 1   # D挡：有驱动力无制动力（主动驱动）
GEAR_D_BRAKE = 2   # D挡：无驱动力有制动力（制动/能量回收）
GEAR_COAST   = 3   # 倒挡或滑行

MSTATE_OFF      = 0
MSTATE_CONSUME  = 1
MSTATE_GENERATE = 2

SBP_OFF = 0


# ============================================================
# 主函数
# ============================================================

def identify_operating_scenes(df: pd.DataFrame) -> pd.DataFrame:
    """
    L1 工况识别主函数

    新增输出字段：
      speed_level, soc_zone, power_kw
      charge_type, brake_type, drive_mode, power_flow
      scene_tag (7类主工况), scene_detail (23类细工况)
      14个特殊工况 flag
      4个滚动统计特征
      event_id, charge_event_id, drive_event_id, rest_event_id
    """
    print("[INFO] 开始 L1 工况识别（深度重构版）...")
    df = df.sort_values(['vin', 'date', 'time']).reset_index(drop=True)

    df = _fill_base_fields(df)
    df['speed_level'] = df['speed'].apply(_classify_speed)
    df['soc_zone']    = df['soc'].apply(_classify_soc)
    df['power_kw']    = (df['tbv'] * df['tbc']) / 1000.0

    df['charge_type'] = _identify_charge_type(df)
    df['brake_type']  = _identify_brake_type(df)
    df['drive_mode']  = _identify_drive_mode(df)
    df['power_flow']  = _identify_power_flow(df)
    df['scene_tag']   = _identify_scene_tag(df)
    df['scene_detail']= _identify_scene_detail(df)

    df = _mark_special_conditions(df)
    df = _split_events(df)
    df = _compute_scene_stats(df)

    _print_scene_summary(df)
    return df


# ============================================================
# Step 1: 基础字段填充
# ============================================================

def _fill_base_fields(df: pd.DataFrame) -> pd.DataFrame:
    fill_map = {
        'vstate': VSTATE_OFF, 'cstate': CSTATE_NO_CHARGE,
        'rstate': 0, 'dcstate': DCSTATE_DISCONNECT,
        'gear': GEAR_P, 'sbp': SBP_OFF,
        'speed': 0.0, 'soc': 50.0,
        'tbc': 0.0, 'tbv': 0.0,
        'mstate_0': MSTATE_OFF, 'mstate_1': MSTATE_OFF,
        'maxt': 25.0, 'mint': 20.0,
        'maxbuv': 3.7, 'minbuv': 3.7,
        'inre': 9999.0, 'ad': 0.0,
    }
    for col, val in fill_map.items():
        if col in df.columns:
            df[col] = df[col].fillna(val)
        else:
            df[col] = val
    return df


# ============================================================
# Step 2: 速度分类
# ============================================================

def _classify_speed(s: float) -> str:
    if s <= SPEED_STATIC:       return 'static'
    elif s <= 20:               return 'creep'
    elif s <= SPEED_MEDIUM:     return 'low_speed'
    elif s <= SPEED_HIGH:       return 'medium_speed'
    elif s <= SPEED_VERY_HIGH:  return 'high_speed'
    else:                       return 'very_high_speed'


# ============================================================
# Step 3: SOC区间分类
# ============================================================

def _classify_soc(soc: float) -> str:
    if soc < SOC_CRITICAL_LOW:  return 'critical_low_soc'
    elif soc < SOC_LOW_ZONE:    return 'low_soc'
    elif soc < 40:              return 'lower_soc'
    elif soc < 70:              return 'normal_soc'
    elif soc < SOC_HIGH_ZONE:   return 'upper_soc'
    elif soc < SOC_FULL:        return 'high_soc'
    else:                       return 'full_soc'


# ============================================================
# Step 4: 充电类型识别
# ============================================================

def _identify_charge_type(df: pd.DataFrame) -> pd.Series:
    """
    5类充电类型：
      fast_charge   : 直流快充（停车+DC连接+大电流）
      slow_charge   : 交流慢充（停车+小电流）
      drive_charge  : 行驶充电（PHEV增程）
      regen_charge  : 能量回收充电
      no_charge     : 未充电
    """
    cstate  = df['cstate']
    dcstate = df['dcstate']
    tbc     = df['tbc']
    speed   = df['speed']
    mstate0 = df['mstate_0']
    mstate1 = df['mstate_1']

    is_moving = speed > SPEED_STATIC
    tbc_abs   = tbc.abs()

    drive_charge = (cstate == CSTATE_DRIVE_CHARGE) & is_moving

    fast_charge = (
        (cstate == CSTATE_PARK_CHARGE) &
        (dcstate == DCSTATE_CONNECTED) &
        (tbc_abs >= FAST_CHARGE_CURRENT) &
        ~is_moving
    )

    slow_charge = (
        (cstate == CSTATE_PARK_CHARGE) &
        ~fast_charge &
        (tbc_abs >= CURRENT_CHARGE_MIN) &
        ~is_moving
    )

    regen_charge = (
        is_moving &
        (cstate == CSTATE_NO_CHARGE) &
        ((mstate0 == MSTATE_GENERATE) | (mstate1 == MSTATE_GENERATE)) &
        (tbc > CURRENT_CHARGE_MIN)
    )

    return pd.Series(np.select(
        [drive_charge, fast_charge, slow_charge, regen_charge],
        ['drive_charge', 'fast_charge', 'slow_charge', 'regen_charge'],
        default='no_charge'
    ), index=df.index)


# ============================================================
# Step 5: 制动类型识别
# ============================================================

def _identify_brake_type(df: pd.DataFrame) -> pd.Series:
    """
    5类制动类型：
      combined_brake    : 联合制动（踩刹车+能量回收）
      regen_brake       : 纯能量回收制动
      mechanical_brake  : 纯机械制动（无回收）
      coasting          : 滑行
      no_brake          : 无制动
    """
    sbp     = df['sbp']
    gear    = df['gear']
    mstate0 = df['mstate_0']
    mstate1 = df['mstate_1']
    speed   = df['speed']

    is_braking_pedal = sbp > SBP_OFF
    is_regen  = (mstate0 == MSTATE_GENERATE) | (mstate1 == MSTATE_GENERATE)
    is_moving = speed > SPEED_STATIC

    combined_brake   = is_moving & is_braking_pedal & is_regen
    regen_brake      = is_moving & ~is_braking_pedal & is_regen & (gear == GEAR_D_BRAKE)
    mechanical_brake = is_moving & is_braking_pedal & ~is_regen
    coasting         = is_moving & ~is_braking_pedal & ~is_regen & (gear == GEAR_COAST)

    return pd.Series(np.select(
        [combined_brake, regen_brake, mechanical_brake, coasting],
        ['combined_brake', 'regen_brake', 'mechanical_brake', 'coasting'],
        default='no_brake'
    ), index=df.index)


# ============================================================
# Step 6: 驱动模式识别
# ============================================================

def _identify_drive_mode(df: pd.DataFrame) -> pd.Series:
    """
    7类驱动模式：
      power_off               : 熄火/下电
      idle_on                 : 上电怠速（P挡静止）
      dual_motor_drive        : 双电机驱动
      single_motor_drive_m0   : M0单驱
      single_motor_drive_m1   : M1单驱
      regen_recovery          : 能量回收
      engine_gen              : 发动机发电（PHEV）
    """
    vstate  = df['vstate']
    rstate  = df['rstate']
    gear    = df['gear']
    mstate0 = df['mstate_0']
    mstate1 = df['mstate_1']
    speed   = df['speed']
    cstate  = df['cstate']

    is_on        = vstate == VSTATE_ON
    is_moving    = speed > SPEED_STATIC
    is_ev        = rstate == RSTATE_EV
    both_consume = (mstate0 == MSTATE_CONSUME) & (mstate1 == MSTATE_CONSUME)
    any_regen    = (mstate0 == MSTATE_GENERATE) | (mstate1 == MSTATE_GENERATE)
    m0_consume   = (mstate0 == MSTATE_CONSUME) & (mstate1 != MSTATE_CONSUME)
    m1_consume   = (mstate1 == MSTATE_CONSUME) & (mstate0 != MSTATE_CONSUME)

    power_off      = vstate == VSTATE_OFF
    idle_on        = is_on & ~is_moving & (cstate == CSTATE_NO_CHARGE) & (gear == GEAR_P)
    dual_drive     = is_on & is_moving & both_consume & is_ev
    m0_drive       = is_on & is_moving & m0_consume & is_ev
    m1_drive       = is_on & is_moving & m1_consume & is_ev
    regen_recovery = is_on & is_moving & any_regen & ~both_consume
    engine_gen     = (
        is_on & (rstate != RSTATE_EV) &
        (cstate == CSTATE_DRIVE_CHARGE) & any_regen
    )

    return pd.Series(np.select(
        [power_off, idle_on, dual_drive, m0_drive,
         m1_drive, regen_recovery, engine_gen],
        ['power_off', 'idle_on', 'dual_motor_drive',
         'single_motor_drive_m0', 'single_motor_drive_m1',
         'regen_recovery', 'engine_gen'],
        default='unknown_drive'
    ), index=df.index)


# ============================================================
# Step 7: 功率流方向识别
# ============================================================

def _identify_power_flow(df: pd.DataFrame) -> pd.Series:
    """
    7类功率流方向：
      dc_fast_charge    : 直流快充输入
      ac_charge         : 交流充电输入
      drive_charge_mix  : 行驶+充电混合
      regen_charge      : 回收充电
      drive_discharge   : 驱动放电
      idle_standby      : 怠速待机
      static_off        : 静置下电
    """
    charge_type = df['charge_type']
    drive_mode  = df['drive_mode']
    power_kw    = df['power_kw']

    return pd.Series(np.select(
        [
            charge_type == 'fast_charge',
            charge_type == 'slow_charge',
            charge_type == 'drive_charge',
            charge_type == 'regen_charge',
            drive_mode.isin(['dual_motor_drive',
                             'single_motor_drive_m0',
                             'single_motor_drive_m1']) & (power_kw.abs() > 1.0),
            drive_mode == 'idle_on',
            drive_mode == 'power_off',
        ],
        [
            'dc_fast_charge', 'ac_charge', 'drive_charge_mix',
            'regen_charge', 'drive_discharge', 'idle_standby', 'static_off',
        ],
        default='unknown_flow'
    ), index=df.index)


# ============================================================
# Step 8: 主工况标签（7类粗粒度）
# ============================================================

def _identify_scene_tag(df: pd.DataFrame) -> pd.Series:
    """
    7类主工况：
      fast_charge  : 直流快充
      slow_charge  : 交流慢充
      drive_charge : 行驶充电（PHEV/增程）
      regen        : 能量回收（含滑行+制动）
      drive        : 纯行驶放电
      rest_on      : 上电静置
      rest_off     : 下电静置（熄火停放）
    """
    charge_type = df['charge_type']
    speed       = df['speed']
    vstate      = df['vstate']

    is_moving = speed > SPEED_STATIC

    return pd.Series(np.select(
        [
            charge_type == 'fast_charge',
            charge_type == 'slow_charge',
            charge_type == 'drive_charge',
            charge_type == 'regen_charge',
            is_moving & (charge_type == 'no_charge'),
            (vstate == VSTATE_ON) & ~is_moving & (charge_type == 'no_charge'),
            vstate == VSTATE_OFF,
        ],
        [
            'fast_charge', 'slow_charge', 'drive_charge',
            'regen', 'drive', 'rest_on', 'rest_off',
        ],
        default='unknown'
    ), index=df.index)


# ============================================================
# Step 9: 详细工况标签（23类细粒度）
# ============================================================

def _identify_scene_detail(df: pd.DataFrame) -> pd.Series:
    """
    23类细粒度工况标签
    优先级从高到低逐一匹配
    """
    scene_tag   = df['scene_tag']
    brake_type  = df['brake_type']
    drive_mode  = df['drive_mode']
    soc_zone    = df['soc_zone']
    speed_level = df['speed_level']
    tbc         = df['tbc']
    maxt        = df['maxt']
    gear        = df['gear']
    tbc_abs     = tbc.abs()

    conditions = [
        # ---- 快充细分 ----
        (scene_tag == 'fast_charge') & (soc_zone == 'full_soc'),
        (scene_tag == 'fast_charge') & (soc_zone.isin(['high_soc', 'full_soc'])),
        (scene_tag == 'fast_charge') & (maxt > TEMP_HIGH_WARNING),
        (scene_tag == 'fast_charge'),

        # ---- 慢充细分 ----
        (scene_tag == 'slow_charge') & (soc_zone == 'full_soc'),
        (scene_tag == 'slow_charge') & (soc_zone.isin(['high_soc', 'full_soc'])),
        (scene_tag == 'slow_charge'),

        # ---- 行驶充电 ----
        (scene_tag == 'drive_charge') & (drive_mode == 'engine_gen'),
        (scene_tag == 'drive_charge'),

        # ---- 能量回收细分 ----
        (scene_tag == 'regen') & (brake_type == 'combined_brake'),
        (scene_tag == 'regen') & (brake_type == 'mechanical_brake'),
        (scene_tag == 'regen') & (brake_type == 'regen_brake'),
        (scene_tag == 'regen') & (brake_type == 'coasting'),

        # ---- 行驶细分 ----
        (scene_tag == 'drive') & (soc_zone.isin(['critical_low_soc', 'low_soc'])),
        (scene_tag == 'drive') & (tbc_abs > FAST_CHARGE_CURRENT),
        (scene_tag == 'drive') & (speed_level == 'very_high_speed'),
        (scene_tag == 'drive') & (speed_level == 'high_speed'),
        (scene_tag == 'drive') & (drive_mode == 'dual_motor_drive'),
        (scene_tag == 'drive') & (speed_level == 'creep'),
        (scene_tag == 'drive'),

        # ---- 上电静置 ----
        (scene_tag == 'rest_on') & (gear == GEAR_P),
        (scene_tag == 'rest_on'),

        # ---- 下电静置 ----
        (scene_tag == 'rest_off') & (tbc_abs > 5),
        (scene_tag == 'rest_off'),
    ]

    choices = [
        'dc_fast_charge_full_soc', 'dc_fast_charge_end_stage',
        'dc_fast_charge_high_temp', 'dc_fast_charge_normal',
        'ac_slow_charge_full_soc', 'ac_slow_charge_end_stage',
        'ac_slow_charge_normal',
        'drive_charge_engine_gen', 'drive_charge_ev_gen',
        'regen_combined_brake', 'regen_mechanical_brake_only',
        'regen_brake_recovery', 'regen_coasting',
        'drive_critical_low_soc', 'drive_heavy_load',
        'drive_very_high_speed', 'drive_high_speed',
        'drive_dual_motor', 'drive_creep', 'drive_normal_ev',
        'idle_on_p_gear', 'idle_on_ready',
        'abnormal_discharge_static', 'rest_off_normal',
    ]

    return pd.Series(
        np.select(conditions, choices, default='unknown_scene'),
        index=df.index
    )


# ============================================================
# Step 10: 特殊工况标记（14个flag）
# ============================================================

def _mark_special_conditions(df: pd.DataFrame) -> pd.DataFrame:
    soc        = df['soc']
    tbc        = df['tbc']
    speed      = df['speed']
    scene      = df['scene_tag']
    soc_z      = df['soc_zone']
    maxt       = df['maxt']
    gear       = df['gear']
    brake_type = df['brake_type']
    vstate     = df['vstate']
    tbc_abs    = tbc.abs()

    df['is_low_soc_high_current'] = (
        soc_z.isin(['critical_low_soc', 'low_soc']) &
        (tbc_abs > FAST_CHARGE_CURRENT)
    ).astype(int)

    df['is_charge_end_stage'] = (
        scene.isin(['fast_charge', 'slow_charge']) & (soc >= 90)
    ).astype(int)

    df['is_full_charge'] = (
        scene.isin(['fast_charge', 'slow_charge']) & (soc >= SOC_FULL)
    ).astype(int)

    df['is_static_state'] = scene.isin(['rest_on', 'rest_off']).astype(int)

    df['is_drive_charge'] = (scene == 'drive_charge').astype(int)

    df['is_regen_braking'] = (
        (scene == 'regen') &
        brake_type.isin(['regen_brake', 'combined_brake'])
    ).astype(int)

    df['is_mechanical_brake_only'] = (
        (scene == 'regen') & (brake_type == 'mechanical_brake')
    ).astype(int)

    df['is_high_speed']  = (speed > 100).astype(int)
    df['is_over_speed']  = (speed > 120).astype(int)

    df['is_charge_over_temp'] = (
        scene.isin(['fast_charge', 'slow_charge']) & (maxt > TEMP_HIGH_WARNING)
    ).astype(int)

    df['is_abnormal_static_discharge'] = (
        scene.isin(['rest_on', 'rest_off']) & (tbc_abs > 5)
    ).astype(int)

    df['is_critical_static_discharge'] = (
        (vstate == VSTATE_OFF) & (tbc_abs > 20)
    ).astype(int)

    df['is_fast_charge']   = (df['charge_type'] == 'fast_charge').astype(int)
    df['is_engine_gen']    = (df['drive_mode'] == 'engine_gen').astype(int)
    df['is_dual_motor_drive'] = (df['drive_mode'] == 'dual_motor_drive').astype(int)
    df['is_critical_low_soc_drive'] = (
        (scene == 'drive') & (soc_z == 'critical_low_soc')
    ).astype(int)

    return df


# ============================================================
# Step 11: 工况事件分割
# ============================================================

def _split_events(df: pd.DataFrame) -> pd.DataFrame:
    def _event_id(g, col):
        return (g[col] != g[col].shift(1)).fillna(True).cumsum()

    grp = df.groupby('vin', group_keys=False)

    df['event_id'] = grp.apply(
        lambda g: _event_id(g, 'scene_tag')
    ).reset_index(drop=True)

    charge_mask = df['scene_tag'].isin(['fast_charge', 'slow_charge', 'drive_charge'])
    df['charge_event_id'] = np.where(
        charge_mask,
        grp.apply(lambda g: _event_id(g, 'charge_type')).reset_index(drop=True),
        np.nan
    )

    drive_mask = df['scene_tag'].isin(['drive', 'regen', 'drive_charge'])
    df['drive_event_id'] = np.where(
        drive_mask,
        grp.apply(lambda g: _event_id(g, 'scene_tag')).reset_index(drop=True),
        np.nan
    )

    rest_mask = df['scene_tag'].isin(['rest_on', 'rest_off'])
    df['rest_event_id'] = np.where(
        rest_mask,
        grp.apply(lambda g: _event_id(g, 'scene_tag')).reset_index(drop=True),
        np.nan
    )

    return df


# ============================================================
# Step 12: 滚动统计特征
# ============================================================

def _compute_scene_stats(df: pd.DataFrame) -> pd.DataFrame:
    grp = df.groupby('vin')
    W = 20

    df['regen_ratio_roll'] = grp['is_regen_braking'].transform(
        lambda x: x.rolling(W, min_periods=1).mean()
    )
    df['fast_charge_roll_cnt'] = grp['is_fast_charge'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['low_soc_high_I_roll'] = grp['is_low_soc_high_current'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['mech_brake_only_roll'] = grp['is_mechanical_brake_only'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['abnormal_static_discharge_roll'] = grp['is_abnormal_static_discharge'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['charge_end_stage_roll'] = grp['is_charge_end_stage'].transform(
        lambda x: x.rolling(W, min_periods=1).mean()
    )
    df['high_speed_roll_ratio'] = grp['is_high_speed'].transform(
        lambda x: x.rolling(W, min_periods=1).mean()
    )

    return df


# ============================================================
# 工况分布打印
# ============================================================

def _print_scene_summary(df: pd.DataFrame):
    print("\n[INFO] 工况识别完成")
    print("-" * 50)
    for label, col in [
        ("主工况(scene_tag)", 'scene_tag'),
        ("驱动模式(drive_mode)", 'drive_mode'),
        ("充电类型(charge_type)", 'charge_type'),
        ("制动类型(brake_type)", 'brake_type'),
    ]:
        print(f"\n  {label}:")
        dist = df[col].value_counts()
        for k, v in dist.items():
            print(f"    {k:<35}: {v:>8,} ({v/len(df)*100:.1f}%)")

    print("\n  特殊工况标记（有记录的）:")
    flags = [
        ('is_low_soc_high_current', '低SOC大电流'),
        ('is_charge_end_stage', '充电末段'),
        ('is_regen_braking', '能量回收制动'),
        ('is_mechanical_brake_only', '纯机械制动无回收'),
        ('is_fast_charge', '快充'),
        ('is_drive_charge', '行驶充电'),
        ('is_engine_gen', '发动机发电'),
        ('is_charge_over_temp', '充电过温'),
        ('is_abnormal_static_discharge', '静置异常放电'),
        ('is_critical_static_discharge', '熄火大电流(严重)'),
        ('is_critical_low_soc_drive', '极低SOC行驶'),
        ('is_over_speed', '超速行驶'),
    ]
    for flag, desc in flags:
        if flag in df.columns:
            cnt = int(df[flag].sum())
            if cnt > 0:
                print(f"    {desc:<20}: {cnt:>8,} ({cnt/len(df)*100:.1f}%)")
    print("-" * 50 + "\n")
