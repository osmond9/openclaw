# 17. 数据打标脚本 label_data.py

## 📄 label_data.py

```python
"""
label_data.py - 数据打标脚本（大数据量内存优化版）

策略：
  - data/raw/normal/ 目录下文件打标 risk_label=0
  - data/raw/risk/   目录下文件打标 risk_label=1
  - 分块处理，每块 CHUNK_SIZE 条，避免内存溢出
  - 使用 PyArrow ParquetWriter 流式写入
  - 数据类型降精度（float64→float32）节省约50%内存

内存估算：
  CHUNK_SIZE=500_000 × 30列 × 4B(float32) ≈ 57MB  ✅
"""

import os
import gc
import glob
import warnings
import numpy as np
import pandas as pd
import pyarrow as pa
import pyarrow.parquet as pq
from pathlib import Path

warnings.filterwarnings('ignore')

# ============================================================
# 配置
# ============================================================
NORMAL_DIR   = 'data/raw/normal/'
RISK_DIR     = 'data/raw/risk/'
LABEL_PATH   = 'data/labels/vehicle_labels.csv'
OUTPUT_PATH  = 'data/labeled/all_vehicles_labeled.parquet'
CHUNK_SIZE   = 500_000     # 根据内存调整
                           # 4GB → 200_000
                           # 8GB → 500_000
                           # 16GB→ 1_000_000

DTYPE_MAP = {
    'vstate': 'int8', 'cstate': 'int8', 'rstate': 'int8',
    'dcstate': 'int8', 'gear': 'int8', 'sbp': 'int8',
    'mstate_0': 'int8', 'mstate_1': 'int8',
    'speed': 'float32', 'soc': 'float32',
    'tbc': 'float32', 'tbv': 'float32',
    'maxt': 'float32', 'mint': 'float32',
    'maxbuv': 'float32', 'minbuv': 'float32',
    'inre': 'float32', 'ad': 'float32',
    'mtor_0': 'float32', 'mtor_1': 'float32',
    'mtemp_0': 'float32', 'mtemp_1': 'float32',
    'mctemp_0': 'float32', 'mctemp_1': 'float32',
}


# ============================================================
# 工具函数
# ============================================================

def downcast_df(df: pd.DataFrame) -> pd.DataFrame:
    for col, dtype in DTYPE_MAP.items():
        if col in df.columns:
            try:
                df[col] = df[col].fillna(0).astype(dtype)
            except Exception:
                pass
    for col in df.select_dtypes(include=['float64']).columns:
        df[col] = pd.to_numeric(df[col], downcast='float')
    for col in df.select_dtypes(include=['int64']).columns:
        df[col] = pd.to_numeric(df[col], downcast='integer')
    return df


def get_files(directory: str) -> list:
    files = []
    for ext in ('.parquet', '.csv'):
        files.extend(glob.glob(os.path.join(directory, f'**/*{ext}'), recursive=True))
        files.extend(glob.glob(os.path.join(directory, f'*{ext}')))
    return sorted(set(files))


def iter_file_chunks(filepath: str, label: int, chunk_size: int):
    """分块迭代读取文件，每块附加标签"""
    ext = Path(filepath).suffix.lower()

    if ext == '.parquet':
        df_full = pd.read_parquet(filepath)
        df_full['risk_label'] = np.int8(label)
        df_full = downcast_df(df_full)
        for start in range(0, len(df_full), chunk_size):
            yield df_full.iloc[start:start + chunk_size].copy()
        del df_full
        gc.collect()

    elif ext == '.csv':
        for chunk in pd.read_csv(filepath, chunksize=chunk_size, low_memory=False):
            chunk['risk_label'] = np.int8(label)
            chunk = downcast_df(chunk)
            yield chunk
            del chunk
            gc.collect()


# ============================================================
# 生成标签文件
# ============================================================

def generate_label_file():
    print("\n[INFO] 扫描VIN并生成标签文件...")
    all_labels = []

    for directory, label, desc in [
        (NORMAL_DIR, 0, '正常'),
        (RISK_DIR,   1, '异常'),
    ]:
        files = get_files(directory)
        vins  = set()
        print(f"  {desc}目录: {directory}, 文件数: {len(files)}")

        for f in files:
            try:
                for chunk in iter_file_chunks(f, label, CHUNK_SIZE):
                    if 'vin' in chunk.columns:
                        vins.update(chunk['vin'].unique().tolist())
                    del chunk
                    gc.collect()
            except Exception as e:
                print(f"    [ERROR] {f}: {e}")

        for vin in vins:
            all_labels.append({
                'vin':        vin,
                'risk_label': label,
                'risk_level': 'High' if label == 1 else 'Low',
                'remarks':    f'{desc}车辆',
            })
        print(f"    唯一VIN数: {len(vins)}")

    df_labels = pd.DataFrame(all_labels)
    # 同一VIN以异常为主
    df_labels = df_labels.sort_values('risk_label', ascending=False)
    df_labels = df_labels.drop_duplicates(subset='vin', keep='first')
    df_labels = df_labels.reset_index(drop=True)

    os.makedirs(os.path.dirname(LABEL_PATH), exist_ok=True)
    df_labels.to_csv(LABEL_PATH, index=False, encoding='utf-8-sig')
    print(f"[INFO] 标签文件已保存: {LABEL_PATH}")
    print(f"       正常: {(df_labels['risk_label']==0).sum()} 
    ```python
#       异常: {(df_labels['risk_label']==1).sum()} 辆")
    return df_labels


# ============================================================
# 主打标流程（流式写入 Parquet）
# ============================================================

def build_labeled_dataset(df_labels: pd.DataFrame):
    """
    流式分块读取所有文件，合并标签，写入单个 Parquet 文件
    避免全量加载到内存
    """
    print("\n[INFO] 开始流式打标写入...")
    os.makedirs(os.path.dirname(OUTPUT_PATH), exist_ok=True)

    # 建立 vin→label 快速查找字典
    vin_label_map = dict(zip(df_labels['vin'], df_labels['risk_label']))

    writer     = None
    schema     = None
    total_rows = 0
    normal_cnt = 0
    risk_cnt   = 0

    for directory, label in [(NORMAL_DIR, 0), (RISK_DIR, 1)]:
        files = get_files(directory)
        desc  = '正常' if label == 0 else '异常'
        print(f"\n  处理{desc}目录: {directory}，文件数: {len(files)}")

        for filepath in files:
            print(f"    读取: {os.path.basename(filepath)}")
            try:
                for chunk in iter_file_chunks(filepath, label, CHUNK_SIZE):
                    # 打标（以 vin_label_map 为准，确保一致性）
                    if 'vin' in chunk.columns:
                        chunk['risk_label'] = (
                            chunk['vin']
                            .map(vin_label_map)
                            .fillna(label)
                            .astype(np.int8)
                        )
                    else:
                        chunk['risk_label'] = np.int8(label)

                    # 统计
                    total_rows += len(chunk)
                    normal_cnt += (chunk['risk_label'] == 0).sum()
                    risk_cnt   += (chunk['risk_label'] == 1).sum()

                    # 转 Arrow Table 并写入
                    table = pa.Table.from_pandas(chunk, preserve_index=False)

                    if writer is None:
                        schema = table.schema
                        writer = pq.ParquetWriter(
                            OUTPUT_PATH,
                            schema,
                            compression='snappy',
                        )

                    # schema 不一致时做兼容处理
                    try:
                        writer.write_table(table)
                    except Exception as e:
                        print(f"      [WARN] schema 不一致，尝试cast: {e}")
                        table = table.cast(schema)
                        writer.write_table(table)

                    del chunk, table
                    gc.collect()

            except Exception as e:
                print(f"    [ERROR] 处理失败: {filepath}, 原因: {e}")
                continue

    if writer is not None:
        writer.close()
        print(f"\n[INFO] Parquet 写入完成: {OUTPUT_PATH}")
    else:
        print("[ERROR] 未写入任何数据，请检查数据路径")
        return

    print(f"[INFO] 总记录数: {total_rows:,}")
    print(f"[INFO] 正常记录: {normal_cnt:,}")
    print(f"[INFO] 异常记录: {risk_cnt:,}")
    print(f"[INFO] 异常占比: {risk_cnt/max(total_rows,1)*100:.2f}%")


# ============================================================
# 验证输出
# ============================================================

def verify_output():
    print("\n[INFO] 验证输出文件...")
    pf = pq.ParquetFile(OUTPUT_PATH)
    meta = pf.metadata
    print(f"  行组数:   {meta.num_row_groups}")
    print(f"  总行数:   {meta.num_rows:,}")
    print(f"  列数:     {meta.num_columns}")

    # 读取前1万行抽查
    sample = pf.read_row_group(0).to_pandas().head(10000)
    print(f"  标签分布 (前10000行):")
    print(f"    {sample['risk_label'].value_counts().to_dict()}")
    print(f"  VIN唯一数 (前10000行): {sample['vin'].nunique()}")
    if 'date' in sample.columns:
        print(f"  日期范围: {sample['date'].min()} ~ {sample['date'].max()}")


# ============================================================
# 入口
# ============================================================

def main():
    print("\n" + "=" * 55)
    print("  动力电池数据打标流程")
    print("=" * 55)

    # Step 1: 生成标签文件
    df_labels = generate_label_file()

    # Step 2: 流式打标写入
    build_labeled_dataset(df_labels)

    # Step 3: 验证
    verify_output()

    print("\n[完成] 数据打标成功！")
    print(f"  标签文件:  {LABEL_PATH}")
    print(f"  全量数据:  {OUTPUT_PATH}")


if __name__ == '__main__':
    main()
