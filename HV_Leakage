```python
"""
pipeline.py - 主流水线控制类
串联 L1→L2→L3 所有算法模块
"""

import pandas as pd
from battery_risk.modules.operating_scene   import identify_operating_scenes
from battery_risk.modules.voltage_risk      import voltage_risk_enhanced
from battery_risk.modules.temperature_risk  import temperature_risk_enhanced
from battery_risk.modules.charge_risk       import identify_charge_events_enhanced
from battery_risk.modules.load_risk         import load_risk_enhanced
from battery_risk.modules.fault_risk        import fault_risk_enhanced
from battery_risk.modules.fusion            import final_risk_fusion_enhanced
from battery_risk.utils import get_memory_usage


class BatteryRiskPipeline:
    """
    动力电池风险识别主流水线

    使用方式：
        pipeline = BatteryRiskPipeline(df_raw)
        result = pipeline.run()
        detail = pipeline.df_processed     # 明细数据
        events = pipeline.charge_events    # 充电事件数据
    """

    def __init__(self, df_raw: pd.DataFrame):
        self.df            = df_raw.copy()
        self.df_processed  = None
        self.charge_events = None
        self.final_risks   = None

    def run(self) -> pd.DataFrame:
        print("\n" + "=" * 55)
        print("  动力电池风险识别流水线 启动")
        print(f"  输入: {len(self.df):,} 条, "
              f"{self.df['vin'].nunique()} 辆, "
              f"内存: {get_memory_usage(self.df)}")
        print("=" * 55 + "\n")

        # L1: 工况识别
        print("[STEP 1/7] L1 工况识别")
        self.df = identify_operating_scenes(self.df)

        # L2-1: 电压风险
        print("[STEP 2/7] L2 电压一致性风险")
        self.df = voltage_risk_enhanced(self.df)

        # L2-2: 温度风险
        print("[STEP 3/7] L2 温度/热风险")
        self.df = temperature_risk_enhanced(self.df)

        # L2-3: 充电风险
        print("[STEP 4/7] L2 充电行为风险")
        self.charge_events = identify_charge_events_enhanced(self.df)

        # L2-4: 负荷风险
        print("[STEP 5/7] L2 高负荷用车风险")
        self.df = load_risk_enhanced(self.df)

        # L2-5: 故障风险
        print("[STEP 6/7] L2 故障/绝缘风险")
        self.df = fault_risk_enhanced(self.df)

        # L3: 综合融合
        print("[STEP 7/7] L3 综合风险融合")
        self.final_risks = final_risk_fusion_enhanced(
            self.df, self.charge_events
        )

        self.df_processed = self.df

        print("\n" + "=" * 55)
        print("  流水线执行完成")
        print(f"  内存: {get_memory_usage(self.df_processed)}")
        print("=" * 55 + "\n")
        return self.final_risks
