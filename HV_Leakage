# 9. L2 电压一致性风险算法

## 📄 battery_risk/modules/voltage_risk.py

```python
"""
voltage_risk.py - L2 电压一致性风险算法

可用字段：maxbuv, minbuv, maxvbn, minvbn, mavbsn, mivbsn
注意：无单体明细电压，只有最高/最低单体电压及节号

风险识别：
  1. 实时压差异常（maxbuv - minbuv）
  2. 固定异常单体（同一节号反复出现）
  3. 过压/欠压
  4. 工况相关压差放大（充电末段、低SOC、高功率）
  5. 压差趋势恶化（滚动斜率）
  6. 单体电压绝对值异常
"""

import numpy as np
import pandas as pd
from scipy import stats
from battery_risk.config import (
    VOLT_MAX_THRESHOLD, VOLT_MIN_THRESHOLD,
    VOLT_DIFF_THRESHOLD, VOLT_DIFF_WARNING,
    VOLT_DIFF_CHARGE_END, VOLT_WINDOW_SIZE,
    ABNORMAL_CELL_REPEAT_TH, FAST_CHARGE_CURRENT,
    SOC_LOW_ZONE, SOC_HIGH_ZONE
)


def voltage_risk_enhanced(df: pd.DataFrame) -> pd.DataFrame:
    """
    电压一致性风险主函数
    输入：含 maxbuv, minbuv, maxvbn, minvbn, soc, tbc, scene_tag 的 DataFrame
    输出：新增 volt_risk_score 及多个中间特征列
    """
    print("[INFO] 开始 L2 电压一致性风险识别...")
    df = df.sort_values(['vin', 'date', 'time']).reset_index(drop=True)

    # ---------- 1. 基础压差特征 ----------
    df['cell_v_delta'] = (df['maxbuv'] - df['minbuv']).clip(lower=0)

    # ---------- 2. 过压/欠压标记 ----------
    df['volt_over']  = (df['maxbuv'] > VOLT_MAX_THRESHOLD).astype(int)
    df['volt_under'] = (df['minbuv'] < VOLT_MIN_THRESHOLD).astype(int)

    # ---------- 3. 压差等级标记 ----------
    df['volt_diff_critical'] = (df['cell_v_delta'] > VOLT_DIFF_THRESHOLD).astype(int)
    df['volt_diff_warning']  = (
        (df['cell_v_delta'] > VOLT_DIFF_WARNING) &
        (df['cell_v_delta'] <= VOLT_DIFF_THRESHOLD)
    ).astype(int)

    # ---------- 4. 工况相关压差放大 ----------
    # 充电末段压差
    df['volt_diff_charge_end'] = np.where(
        df.get('is_charge_end_stage', pd.Series(0, index=df.index)) == 1,
        df['cell_v_delta'],
        np.nan
    )
    # 低SOC压差
    df['volt_diff_low_soc'] = np.where(
        df['soc'] < SOC_LOW_ZONE,
        df['cell_v_delta'],
        np.nan
    )
    # 高功率压差（|tbc| > FAST_CHARGE_CURRENT）
    df['volt_diff_high_power'] = np.where(
        df['tbc'].abs() > FAST_CHARGE_CURRENT,
        df['cell_v_delta'],
        np.nan
    )

    # ---------- 5. 滚动窗口统计 ----------
    grp = df.groupby('vin')
    W   = VOLT_WINDOW_SIZE

    df['volt_diff_roll_max']  = grp['cell_v_delta'].transform(
        lambda x: x.rolling(W, min_periods=1).max()
    )
    df['volt_diff_roll_mean'] = grp['cell_v_delta'].transform(
        lambda x: x.rolling(W, min_periods=1).mean()
    )
    df['volt_diff_roll_std']  = grp['cell_v_delta'].transform(
        lambda x: x.rolling(W, min_periods=1).std().fillna(0)
    )
    df['volt_over_roll']      = grp['volt_over'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['volt_under_roll']     = grp['volt_under'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['volt_diff_critical_roll'] = grp['volt_diff_critical'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )

    # ---------- 6. 压差趋势斜率（恶化检测）----------
    def _rolling_slope(series, window=W):
        """计算滚动线性回归斜率"""
        result = np.full(len(series), 0.0)
        arr = series.values
        for i in range(window - 1, len(arr)):
            y = arr[i - window + 1: i + 1]
            if np.all(np.isfinite(y)):
                x = np.arange(window)
                slope, _, _, _, _ = stats.linregress(x, y)
                result[i] = slope
        return result

    df['volt_diff_slope'] = grp['cell_v_delta'].transform(
        lambda x: pd.Series(_rolling_slope(x, W), index=x.index)
    )
    # 斜率为正表示压差在恶化
    df['volt_diff_deteriorating'] = (df['volt_diff_slope'] > 0.005).astype(int)

    # ---------- 7. 固定异常单体识别 ----------
    # 在一个滚动窗口内，同一节号重复出现次数
    def _repeat_cell_count(g, col, window=20):
        """计算每个位置滚动窗口内相同节号的出现次数"""
        vals = g[col].values
        result = np.zeros(len(vals), dtype=int)
        for i in range(len(vals)):
            start = max(0, i - window + 1)
            window_vals = vals[start:i + 1]
            if len(window_vals) > 0 and not np.isnan(vals[i]):
                result[i] = np.sum(window_vals == vals[i])
        return pd.Series(result, index=g.index)

    if 'maxvbn' in df.columns:
        df['max_cell_repeat_cnt'] = grp.apply(
            lambda g: _repeat_cell_count(g, 'maxvbn', 20)
        ).reset_index(drop=True)
    else:
        df['max_cell_repeat_cnt'] = 0

    if 'minvbn' in df.columns:
        df['min_cell_repeat_cnt'] = grp.apply(
            lambda g: _repeat_cell_count(g, 'minvbn', 20)
        ).reset_index(drop=True)
    else:
        df['min_cell_repeat_cnt'] = 0

    df['abnormal_cell_flag'] = (
        (df['max_cell_repeat_cnt'] >= ABNORMAL_CELL_REPEAT_TH) |
        (df['min_cell_repeat_cnt'] >= ABNORMAL_CELL_REPEAT_TH)
    ).astype(int)

    # ---------- 8. 综合电压风险评分 ----------
    # 各分项归一化到 [0, 1]，再加权求和到 [0, 3]
    score_over_under = (
        (df['volt_over_roll'] + df['volt_under_roll']) / W
    ).clip(0, 1) * 1.0   # 权重1.0

    score_diff = (
        df['volt_diff_critical_roll'] / W
    ).clip(0, 1) * 0.8   # 权重0.8

    score_diff_mean = (
        (df['volt_diff_roll_mean'] / VOLT_DIFF_THRESHOLD).clip(0, 1)
    ) * 0.5              # 权重0.5

    score_abnormal_cell = df['abnormal_cell_flag'].astype(float) * 0.5

    score_deteriorate = df['volt_diff_deteriorating'].astype(float) * 0.2

    df['volt_risk_score'] = (
        score_over_under +
        score_diff +
        score_diff_mean +
        score_abnormal_cell +
        score_deteriorate
    ).clip(0, 3.0).round(4)

    # ---------- 9. 异常单体节号记录 ----------
    # 记录风险最高时刻对应的异常单体节号
    df['abnormal_cell_no'] = np.where(
        df['volt_risk_score'] > 1.0,
        np.where(
            df['max_cell_repeat_cnt'] >= df['min_cell_repeat_cnt'],
            df.get('maxvbn', pd.Series(np.nan, index=df.index)),
            df.get('minvbn', pd.Series(np.nan, index=df.index))
        ),
        np.nan
    )

    print(f"[INFO] 电压风险识别完成，"
          f"平均分: {df['volt_risk_score'].mean():.4f}, "
          f"最大分: {df['volt_risk_score'].max():.4f}")
    return df
