```python
"""
utils.py
通用工具函数：数据加载、保存、类型优化、标签管理
"""
import os
import gc
import glob
import warnings
import numpy as np
import pandas as pd
from pathlib import Path
from battery_risk.config import (
    DATA_LABELS_PATH, LABELED_DATA_PATH,
    OUTPUT_PATH, FIGURE_DIR, DTYPE_DOWNCAST_MAP,
    RISK_LEVEL_THRESHOLDS, CHUNK_SIZE
)

warnings.filterwarnings('ignore')


# ============================================================
# 数据类型优化
# ============================================================

def downcast_dataframe(df: pd.DataFrame) -> pd.DataFrame:
    """对DataFrame进行降精度，减少内存约50%"""
    for col, dtype in DTYPE_DOWNCAST_MAP.items():
        if col in df.columns:
            try:
                df[col] = df[col].fillna(0).astype(dtype)
            except Exception:
                pass
    # 自动降精度其余float64列
    for col in df.select_dtypes(include=['float64']).columns:
        df[col] = pd.to_numeric(df[col], downcast='float')
    # 自动降精度其余int64列
    for col in df.select_dtypes(include=['int64']).columns:
        df[col] = pd.to_numeric(df[col], downcast='integer')
    return df


def get_memory_usage(df: pd.DataFrame) -> str:
    """返回DataFrame内存占用的可读字符串"""
    mem = df.memory_usage(deep=True).sum()
    if mem < 1024 ** 2:
        return f"{mem / 1024:.1f} KB"
    elif mem < 1024 ** 3:
        return f"{mem / 1024 ** 2:.1f} MB"
    else:
        return f"{mem / 1024 ** 3:.2f} GB"


# ============================================================
# 数据加载
# ============================================================

def load_labeled_data(
        path: str = None,
        columns: list = None,
        filters=None
) -> pd.DataFrame:
    """
    加载打标后全量数据
    参数：
      columns : 只加载指定列（减少内存）
      filters : pyarrow过滤条件，如 [('risk_label','=',1)]
    """
    _path = path or LABELED_DATA_PATH
    print(f"[INFO] 加载数据: {_path}")

    try:
        df = pd.read_parquet(_path, columns=columns, filters=filters)
    except Exception as e:
        print(f"[WARN] 带过滤读取失败({e})，尝试全量读取...")
        df = pd.read_parquet(_path)
        if columns:
            avail = [c for c in columns if c in df.columns]
            df = df[avail]

    df = downcast_dataframe(df)

    print(f"[INFO] 加载完成: {len(df):,} 条, "
          f"{df['vin'].nunique()} 辆, 内存: {get_memory_usage(df)}")
    return df


def load_labels(path: str = DATA_LABELS_PATH) -> pd.DataFrame:
    """加载VIN级别标签文件"""
    print(f"[INFO] 加载标签: {path}")
    df = pd.read_csv(path)
    print(f"[INFO] 标签记录: {len(df)} 条, "
          f"正常: {(df['risk_label'] == 0).sum()}, "
          f"异常: {(df['risk_label'] == 1).sum()}")
    return df


def get_all_files(directory: str,
                  extensions=('.parquet', '.csv')) -> list:
    """获取目录下所有数据文件"""
    files = []
    for ext in extensions:
        files.extend(glob.glob(
            os.path.join(directory, f'**/*{ext}'), recursive=True))
        files.extend(glob.glob(
            os.path.join(directory, f'*{ext}')))
    return sorted(set(files))


# ============================================================
# 结果保存
# ============================================================

def save_results(df_results: pd.DataFrame, path: str = OUTPUT_PATH):
    """保存最终风险评分结果"""
    os.makedirs(os.path.dirname(path) if os.path.dirname(path) else '.', exist_ok=True)
    df_results.to_csv(path, index=False, encoding='utf-8-sig')
    print(f"[INFO] 风险结果已保存: {path}, 共 {len(df_results)} 条")


def ensure_dir(path: str):
    """确保目录存在"""
    os.makedirs(path, exist_ok=True)


# ============================================================
# 风险等级与建议
# ============================================================

def risk_level_from_score(score: float) -> str:
    """根据风险分返回风险等级"""
    if score < RISK_LEVEL_THRESHOLDS['Low']:
        return 'Low'
    elif score < RISK_LEVEL_THRESHOLDS['Medium']:
        return 'Medium'
    elif score < RISK_LEVEL_THRESHOLDS['High']:
        return 'High'
    else:
        return 'Critical'


def recommend_action(level: str) -> str:
    """根据风险等级给出建议动作"""
    actions = {
        'Low':      '正常使用，无需操作',
        'Medium':   '建议监控，关注风险变化趋势',
        'High':     '建议安排定期检查与维护',
        'Critical': '风险极高，请立即停用并检修',
    }
    return actions.get(level, '未知')


def get_main_risk_reason(row: pd.Series) -> str:
    """根据各子分找出主要风险原因"""
    sub_scores = {
        '电压一致性异常': row.get('volt_risk_score', 0),
        '温度/热风险异常': row.get('temp_risk_score', 0),
        '充电行为异常': row.get('charge_risk_score', 0),
        '高负荷用车': row.get('load_risk_score', 0),
        '故障/绝缘异常': row.get('fault_risk_score', 0),
    }
    if max(sub_scores.values()) == 0:
        return '无明显异常'
    return max(sub_scores, key=sub_scores.get)
