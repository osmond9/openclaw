```python
"""
generate_sample_data.py
生成符合真实字段格式的测试数据，用于快速验证流水线
正常车辆 5 辆 × 1000 条 = 5000 条
异常车辆 3 辆 × 1000 条 = 3000 条
"""

import os
import numpy as np
import pandas as pd

NORMAL_DIR = 'data/raw/normal/'
RISK_DIR   = 'data/raw/risk/'
SEED       = 42
np.random.seed(SEED)


def _base_df(vin: str, n: int, is_risk: bool) -> pd.DataFrame:
    """生成单辆车基础时序数据"""
    dates = pd.date_range('2024-01-01', periods=n, freq='1min')

    soc = np.clip(
        50 + np.cumsum(np.random.randn(n) * 0.3),
        5, 100
    )
    tbv = np.random.uniform(340, 400, n)

    # 异常车辆：注入明显异常信号
    if is_risk:
        # 压差放大
        maxbuv = np.random.uniform(3.80, 4.25, n)
        minbuv = maxbuv - np.random.uniform(0.20, 0.50, n)
        # 温度偏高，温差大
        maxt = np.random.uniform(38, 60, n)
        mint = maxt - np.random.uniform(8, 18, n)
        # 低绝缘
        inre = np.random.uniform(50, 300, n)
        aobf = np.random.randint(0, 5, n)
    else:
        maxbuv = np.random.uniform(3.50, 4.15, n)
        minbuv = maxbuv - np.random.uniform(0.01, 0.08, n)
        maxt = np.random.uniform(20, 38, n)
        mint = maxt - np.random.uniform(1, 5, n)
        inre = np.random.uniform(800, 2000, n)
        aobf = np.zeros(n, dtype=int)

    minbuv = np.clip(minbuv, 2.5, 4.2)
    mint   = np.clip(mint, -10, 45)

    tbc = np.where(
        np.random.rand(n) > 0.5,
        np.random.uniform(5, 150, n),    # 充电
        -np.random.uniform(5, 200, n)    # 放电
    )

    df = pd.DataFrame({
        'vin':          vin,
        'month':        dates.to_period('M').astype(str),
        'date':         dates.strftime('%Y-%m-%d'),
        'time':         dates.strftime('%H:%M:%S'),
        'arrival_time': dates.strftime('%Y-%m-%d %H:%M:%S'),
        'run_hour':     np.cumsum(np.random.uniform(0, 0.02, n)),
        'vstate':       np.random.choice([0, 1, 2], n, p=[0.3, 0.5, 0.2]),
        'cstate':       np.where(tbc > 0, 1, 0),
        'rstate':       np.random.randint(0, 3, n),
        'speed':        np.abs(np.random.randn(n) * 30).clip(0, 130),
        'mil':          np.cumsum(np.random.uniform(0, 0.5, n)),
        'tbv':          tbv,
        'tbc':          tbc,
        'soc':          soc,
        'dcstate':      np.random.choice([0, 1], n, p=[0.7, 0.3]),
        'gear':         np.random.choice([0, 1, 2, 3], n),
        'inre':         inre,
        'ad':           np.random.randn(n) * 2,
        'sbp':          np.random.uniform(0, 100, n),
        'aom':          np.random.randint(0, 4, n),
        'dm_list':      None,
        'mnum_0':       0,
        'mstate_0':     np.random.randint(0, 3, n),
        'mctemp_0':     np.random.uniform(20, 80, n),
        'mrs_0':        np.random.randint(0, 2, n),
        'mtor_0':       np.random.uniform(-200, 200, n),
        'mtemp_0':      np.random.uniform(20, 100, n),
        'mcinv_0':      np.random.uniform(0, 1, n),
        'mcdbc_0':      np.random.uniform(0, 1, n),
        'mnum_1':       1,
        'mstate_1':     np.random.randint(0, 3, n),
        'mctemp_1':     np.random.uniform(20, 80, n),
        'mrs_1':        np.random.randint(0, 2, n),
        'mtor_1':       np.random.uniform(-200, 200, n),
        'mtemp_1':      np.random.uniform(20, 100, n),
        'mcinv_1':      np.random.uniform(0, 1, n),
        'mcdbc_1':      np.random.uniform(0, 1, n),
        'mavbsn':       np.random.randint(1, 96, n),
        'maxvbn':       np.random.randint(1, 96, n),
        'maxbuv':       maxbuv,
        'mivbsn':       np.random.randint(1, 96, n),
        'minvbn':       np.random.randint(1, 96, n),
        'minbuv':       minbuv,
        'matban':       np.random.randint(1, 16, n),
        'maxtn':        np.random.randint(1, 16, n),
        'maxt':         maxt,
        'mitban':       np.random.randint(1, 16, n),
        'mintn':        np.random.randint(1, 16, n),
        'mint':         mint,
        'halvl':        np.random.choice([0, 1, 2, 3], n, p=[0.85, 0.10, 0.04, 0.01]),
        'uai':          np.random.randint(0, 3, n),
        'aobf':         aobf,
        'aodmf':        np.random.randint(0, 2, n),
        'aoef':         np.zeros(n, dtype=int),
        'aoof':         np.random.randint(0, 2, n),
        'aobsv':        np.random.randint(0, 3, n),
        'battery_code': 'BAT_TYPE_A',
        'notice':       None,
        'purchase_date':'2022-06-01',
        'software_version': 'V2.1.0',
        'software_code':    'SW001',
        'cn_car_type':      'SUV',
        'car_type':         'BEV',
        'project_no':       'PRJ_001',
        'ev_phev':          'EV',
        'code_version':     'CV_01',
    })
    return df


def main():
    os.makedirs(NORMAL_DIR, exist_ok=True)
    os.makedirs(RISK_DIR,   exist_ok=True)

    # 正常车辆
    normal_vins = [f'NORM_VIN_{i:03d}' for i in range(5)]
    dfs_normal  = [_base_df(v, 1000, is_risk=False) for v in normal_vins]
    df_normal   = pd.concat(dfs_normal, ignore_index=True)
    out_n       = os.path.join(NORMAL_DIR, 'normal_vehicles.parquet')
    df_normal.to_parquet(out_n, index=False)
    print(f"[INFO] 正常车辆数据已保存: {out_n} ({len(df_normal):,} 条)")

    # 异常车辆
    risk_vins = [f'RISK_VIN_{i:03d}' for i in range(3)]
    dfs_risk  = [_base_df(v, 1000, is_risk=True) for v in risk_vins]
    df_risk   = pd.concat(dfs_risk, ignore_index=True)
    out_r     = os.path.join(RISK_DIR, 'risk_vehicles.parquet')
    df_risk.to_parquet(out_r, index=False)
    print(f"[INFO] 异常车辆数据已保存: {out_r} ({len(df_risk):,} 条)")

    print("\n[完成] 测试数据生成成功")
    print(f"  运行 'python main.py --mode all' 开始完整流程")


if __name__ == '__main__':
    main()
