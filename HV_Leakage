# 11. L2 充电行为风险算法

## 📄 battery_risk/modules/charge_risk.py

```python
"""
charge_risk.py - L2 充电行为风险算法

风险识别：
  1. 快充频繁
  2. 满充久置（高SOC长时停留）
  3. 充电末段压差/温升异常
  4. 充电过温
  5. 低SOC起充
  6. 充电中断频繁
  7. 夜间长时快充
"""

import numpy as np
import pandas as pd
from battery_risk.config import (
    CHARGE_SOC_START_LOW, CHARGE_TEMP_MAX,
    CHARGE_TEMP_RISE_RATE, FULL_CHARGE_SOC,
    HIGH_SOC_RESIDENCE, FAST_CHARGE_CNT_7D_TH,
    CHARGE_INTERRUPT_TH, VOLT_DIFF_CHARGE_END,
    FAST_CHARGE_CURRENT
)


def identify_charge_events_enhanced(df: pd.DataFrame) -> pd.DataFrame:
    """
    充电行为风险主函数

    输入：含 scene_tag, soc, tbc, maxt, maxbuv, minbuv,
              charge_event_id, is_charge_end_stage 的 DataFrame
    输出：充电事件风险汇总DataFrame（每个充电事件一行）
    """
    print("[INFO] 开始 L2 充电行为风险识别...")

    # ---- 过滤出充电段 ----
    charge_scenes = ['fast_charge', 'slow_charge', 'drive_charge']
    df_chg = df[df['scene_tag'].isin(charge_scenes)].copy()

    if df_chg.empty:
        print("[WARN] 未发现充电事件，跳过")
        return pd.DataFrame()

    # ---- 充电事件聚合 ----
    agg_dict = {
        'soc': ['first', 'last', 'max', 'min'],
        'tbc': ['mean', 'max', 'min'],
        'maxt': ['max', 'mean'],
        'mint': 'min',
        'maxbuv': ['max', 'last'],
        'minbuv': ['min', 'last'],
        'date': 'first',
        'time': ['first', 'count'],
        'scene_tag': 'first',
        'is_charge_end_stage': 'sum',
        'is_charge_over_temp': 'sum',
    }

    # 确保聚合字段存在
    agg_dict_clean = {}
    for col, func in agg_dict.items():
        if col in df_chg.columns:
            agg_dict_clean[col] = func

    charge_summary = df_chg.groupby(
        ['vin', 'charge_event_id']
    ).agg(agg_dict_clean)

    # 展平多级列名
    charge_summary.columns = [
        '_'.join(filter(None, map(str, c))).strip('_')
        if isinstance(c, tuple) else c
        for c in charge_summary.columns
    ]
    charge_summary = charge_summary.reset_index()

    # ---- 列名重命名（统一化） ----
    rename_map = {
        'soc_first':   'soc_start',
        'soc_last':    'soc_end',
        'soc_max':     'soc_max',
        'soc_min':     'soc_min',
        'tbc_mean':    'avg_charge_current',
        'tbc_max':     'max_charge_current',
        'tbc_min':     'min_charge_current',
        'maxt_max':    'temp_max_charge',
        'maxt_mean':   'temp_avg_charge',
        'mint_min':    'temp_min_charge',
        'maxbuv_max':  'volt_max_charge',
        'maxbuv_last': 'volt_max_end',
        'minbuv_min':  'volt_min_charge',
        'minbuv_last': 'volt_min_end',
        'date_first':  'charge_date',
        'time_first':  'charge_start_time',
        'time_count':  'charge_duration',
        'scene_tag_first': 'charge_type_tag',
        'is_charge_end_stage_sum': 'end_stage_cnt',
        'is_charge_over_temp_sum': 'over_temp_cnt',
    }
    charge_summary = charge_summary.rename(columns={
        k: v for k, v in rename_map.items() if k in charge_summary.columns
    })

    # ---- 充电深度 ----
    if 'soc_start' in charge_summary and 'soc_end' in charge_summary:
        charge_summary['charge_depth'] = (
            charge_summary['soc_end'] - charge_summary['soc_start']
        ).clip(lower=0)

    # ---- 充电末段压差 ----
    if 'volt_max_end' in charge_summary and 'volt_min_end' in charge_summary:
        charge_summary['charge_end_v_delta'] = (
            charge_summary['volt_max_end'] - charge_summary['volt_min_end']
        ).clip(lower=0)
    else:
        charge_summary['charge_end_v_delta'] = 0

    # ---- 快充类型权重 ----
    charge_summary['is_fast_charge_event'] = (
        charge_summary.get('charge_type_tag', '') == 'fast_charge'
    ).astype(int)
    fast_weight = np.where(
        charge_summary['is_fast_charge_event'] == 1, 1.5, 1.0
    )

    # ---- 风险打分各分项 ----

    # 1. 低SOC起充（<15%）
    r_low_soc_start = (
        charge_summary.get('soc_start', 50) < CHARGE_SOC_START_LOW
    ).astype(float)

    # 2. 充电过温
    r_over_temp = (
        charge_summary.get('temp_max_charge', 25) > CHARGE_TEMP_MAX
    ).astype(float)

    # 3. 充电末段过温（末段记录中有过温）
    r_end_over_temp = (
        charge_summary.get('over_temp_cnt', 0) > 0
    ).astype(float) * 0.8

    # 4. 充电末段压差过大
    r_end_v_delta = (
        charge_summary['charge_end_v_delta'] > VOLT_DIFF_CHARGE_END
    ).astype(float) * 0.8

    # 5. 满充（SOC≥98%，有老化风险）
    r_full_charge = (
        charge_summary.get('soc_end', 50) >= FULL_CHARGE_SOC
    ).astype(float) * 0.5

    # ---- 综合充电事件风险分 ----
    charge_summary['charge_risk_score'] = (
        (r_low_soc_start * 0.3 +
         r_over_temp * 0.3 +
         r_end_over_temp * 0.2 +
         r_end_v_delta * 0.15 +
         r_full_charge * 0.05) * fast_weight
    ).clip(0, 3.0).round(4)

    # ---- VIN级别充电行为统计 ----
    vin_charge_stats = _compute_vin_charge_stats(charge_summary, df)
    charge_summary = charge_summary.merge(vin_charge_stats, on='vin', how='left')

    print(f"[INFO] 充电事件识别完成，共 {len(charge_summary)} 个充电事件")
    print(f"[INFO] 平均充电风险分: {charge_summary['charge_risk_score'].mean():.4f}")
    return charge_summary


def _compute_vin_charge_stats(
        charge_summary: pd.DataFrame,
        df_raw: pd.DataFrame
) -> pd.DataFrame:
    """
    计算VIN级别的充电行为统计特征
    用于综合融合
    """
    vin_stats = charge_summary.groupby('vin').agg(
        total_charge_cnt     = ('charge_risk_score', 'count'),
        fast_charge_cnt      = ('is_fast_charge_event', 'sum'),
        full_charge_cnt      = ('soc_end', lambda x: (x >= FULL_CHARGE_SOC).sum()),
        avg_charge_risk      = ('charge_risk_score', 'mean'),
        max_charge_risk      = ('charge_risk_score', 'max'),
        avg_soc_start        = ('soc_start', 'mean'),
        avg_charge_depth     = ('charge_depth', 'mean'),
        avg_charge_end_vdelta= ('charge_end_v_delta', 'mean'),
    ).reset_index()

    # 高SOC停留时长（从原始数据中统计）
    if 'soc' in df_raw.columns and 'scene_tag' in df_raw.columns:
        high_soc_res = (
            df_raw[
                (df_raw['soc'] >= 90) &
                df_raw['scene_tag'].isin(['rest_on', 'rest_off'])
            ].groupby('vin').size().reset_index(name='high_soc_residence_cnt')
        )
        vin_stats = vin_stats.merge(high_soc_res, on='vin', how='left')
        vin_stats['high_soc_residence_cnt'] = (
            vin_stats['high_soc_residence_cnt'].fillna(0)
        )

    return vin_stats
