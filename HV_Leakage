"""
utils.py - 完整工具函数
"""

import os
import gc
import sys
import numpy as np
import pandas as pd
from battery_risk.config import (
    LABELED_DATA_PATH, OUTPUT_RISK_PATH, FIGURE_DIR,
    RISK_LEVEL_THRESHOLDS
)


# ============================================================
# 数据加载
# ============================================================

def load_labeled_data(path: str = LABELED_DATA_PATH) -> pd.DataFrame:
    """加载带标签的全量数据"""
    print(f"[INFO] 加载数据: {path}")
    if not os.path.exists(path):
        raise FileNotFoundError(
            f"数据文件不存在: {path}\n"
            "请先运行: python label_data.py"
        )

    if path.endswith('.parquet'):
        df = pd.read_parquet(path)
    else:
        df = pd.read_csv(path, low_memory=False)

    # 统一时间格式
    if 'date' in df.columns and 'time' in df.columns:
        try:
            df['datetime'] = pd.to_datetime(
                df['date'].astype(str) + ' ' + df['time'].astype(str),
                errors='coerce'
            )
        except Exception:
            pass

    # 补充 purchase_date 转换
    if 'purchase_date' in df.columns:
        df['purchase_date'] = pd.to_datetime(df['purchase_date'], errors='coerce')

    print(f"[INFO] 加载完成: {len(df):,} 条, {df['vin'].nunique()} 辆")
    if 'risk_label' in df.columns:
        n = (df['risk_label'] == 0).sum()
        r = (df['risk_label'] == 1).sum()
        print(f"[INFO] 正常: {n:,}, 异常: {r:,}")
    print(f"[INFO] 内存占用: {get_memory_usage(df)}")
    return df


def load_labels(path: str) -> pd.DataFrame:
    return pd.read_csv(path)


# ============================================================
# 内存工具
# ============================================================

def get_memory_usage(df: pd.DataFrame) -> str:
    mem = df.memory_usage(deep=True).sum()
    if mem < 1024 ** 2:
        return f"{mem / 1024:.1f} KB"
    elif mem < 1024 ** 3:
        return f"{mem / 1024 ** 2:.1f} MB"
    else:
        return f"{mem / 1024 ** 3:.2f} GB"


def reduce_memory(df: pd.DataFrame, verbose: bool = True) -> pd.DataFrame:
    """自动降精度减少内存"""
    start_mem = df.memory_usage(deep=True).sum() / 1024 ** 2

    for col in df.columns:
        col_type = df[col].dtype
        if col_type == object:
            continue
        elif col_type in ['float64']:
            df[col] = pd.to_numeric(df[col], downcast='float')
        elif col_type in ['int64', 'int32']:
            df[col] = pd.to_numeric(df[col], downcast='integer')

    end_mem = df.memory_usage(deep=True).sum() / 1024 ** 2
    if verbose:
        print(f"[INFO] 内存压缩: {start_mem:.1f}MB → {end_mem:.1f}MB "
              f"(节省 {(start_mem-end_mem)/start_mem*100:.1f}%)")
    return df


# ============================================================
# 列检查工具
# ============================================================

def ensure_cols(df: pd.DataFrame, cols: list, fill=0.0) -> pd.DataFrame:
    """确保指定列存在，缺失则填充默认值"""
    for col in cols:
        if col not in df.columns:
            df[col] = fill
            print(f"[WARN] 列 '{col}' 不存在，已填充默认值 {fill}")
    return df


def safe_divide(a, b, fill: float = 0.0):
    """安全除法，避免除零"""
    return np.where(b != 0, a / b, fill)


# ============================================================
# 风险等级判断
# ============================================================

def risk_level_from_score(score: float) -> str:
    """
    根据综合风险分返回等级
    分数范围 0~3（各子分叠加）
    """
    thresholds = RISK_LEVEL_THRESHOLDS  # [(阈值, 等级), ...]
    for threshold, level in thresholds:
        if score <= threshold:
            return level
    return 'Critical'


def recommend_action(risk_level: str) -> str:
    """根据风险等级返回建议动作"""
    actions = {
        'Low':      '正常使用，定期关注',
        'Medium':   '建议近期复查，关注趋势变化',
        'High':     '建议安排专业检测，暂停高负荷使用',
        'Critical': '立即停用，安排紧急检修，排查隐患',
    }
    return actions.get(risk_level, '建议检查')


def get_main_risk_reason(row: pd.Series) -> str:
    """
    从融合后的 vin 级别结果行中，找出最高子风险作为主因
    （供 fusion.py 直接调用，避免循环引用）
    """
    candidates = {
        '电压一致性异常': float(row.get('volt_risk_score_mean', 0) or 0),
        '温度/热风险':    float(row.get('temp_risk_score_mean', 0) or 0),
        '充电行为异常':   float(row.get('charge_risk_score_mean', 0) or 0),
        '高负荷用车':     float(row.get('load_risk_score_mean', 0) or 0),
        '故障/绝缘异常':  float(row.get('fault_risk_score_mean', 0) or 0),
    }
    max_score = max(candidates.values())
    if max_score < 0.05:
        return '无明显异常'
    return max(candidates, key=candidates.get)


# ============================================================
# 结果保存
# ============================================================

def save_results(df: pd.DataFrame, path: str = OUTPUT_RISK_PATH):
