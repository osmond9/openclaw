# 20. 主程序入口

## 📄 main.py

```python
"""
main.py - 主程序入口

用法:
  python main.py --mode all        # 完整流程（打标+算法+可视化）
  python main.py --mode label      # 仅打标
  python main.py --mode run        # 仅运行算法（需已打标）
  python main.py --mode viz        # 仅可视化（需已运行算法）
  python main.py --mode sample     # 生成测试数据并运行
"""

import os
import sys
import argparse
import warnings
import pandas as pd

warnings.filterwarnings('ignore')

from battery_risk.utils       import load_labeled_data, save_results, ensure_figure_dir
from battery_risk.pipeline    import BatteryRiskPipeline
from battery_risk.config      import OUTPUT_RISK_PATH, LABELED_DATA_PATH


def parse_args():
    parser = argparse.ArgumentParser(description='动力电池风险识别系统')
    parser.add_argument(
        '--mode',
        choices=['all', 'label', 'run', 'viz', 'sample'],
        default='all',
        help='运行模式'
    )
    parser.add_argument(
        '--vin',
        type=str,
        default=None,
        help='指定单车VIN（用于单车时序过程图）'
    )
    parser.add_argument(
        '--sample-size',
        type=int,
        default=None,
        help='抽样行数（测试用，不填则全量）'
    )
    return parser.parse_args()


def step_label():
    """Step 1: 数据打标"""
    print("\n[STEP] 执行数据打标...")
    import label_data
    label_data.main()


def step_run(sample_size=None):
    """Step 2: 运行风险识别算法"""
    print("\n[STEP] 运行风险识别算法...")
    df = load_labeled_data(LABELED_DATA_PATH)

    if sample_size:
        print(f"[INFO] 抽样 {sample_size:,} 条用于测试")
        df = df.sample(min(sample_size, len(df)), random_state=42)

    pipeline = BatteryRiskPipeline(df)
    final_risks = pipeline.run()

    save_results(final_risks, OUTPUT_RISK_PATH)
    return pipeline.df_processed, final_risks, pipeline.charge_events


def step_viz(df_processed=None, final_risks=None, vin=None):
    """Step 3: 可视化"""
    print("\n[STEP] 执行可视化分析...")
    ensure_figure_dir()

    # 若未传入，尝试从文件加载
    if df_processed is None:
        df_processed = load_labeled_data(LABELED_DATA_PATH)

    if final_risks is None and os.path.exists(OUTPUT_RISK_PATH):
        final_risks = pd.read_csv(OUTPUT_RISK_PATH)

    from visualization import plot_all
    plot_all(df_processed, final_risks)

    # 单车时序图（若指定VIN）
    if vin:
        plot_single_vehicle(df_processed, vin)


def plot_single_vehicle(df: pd.DataFrame, vin: str):
    """单车时序过程参数图"""
    import matplotlib.pyplot as plt
    from matplotlib import rcParams
    rcParams['font.sans-serif'] = ['SimHei', 'DejaVu Sans']
    rcParams['axes.unicode_minus'] = False

    df_v = df[df['vin'] == vin].sort_values('datetime' if 'datetime' in df.columns else 'time')
    if df_v.empty:
        print(f"[WARN] VIN {vin} 无数据")
        return

    fig, axes = plt.subplots(5, 1, figsize=(16, 18), sharex=True)
    fig.suptitle(f'单车时序过程参数图  VIN: {vin}', fontsize=13, fontweight='bold')

    x = range(len(df_v))

    # SOC
    if 'soc' in df_v.columns:
        axes[0].plot(x, df_v['soc'], color='#2196F3', lw=1)
        axes[0].set_ylabel('SOC (%)')
        axes[0].axhline(20, color='red', linestyle='--', alpha=0.5)
        axes[0].set_ylim(0, 105)

    # 电压压差
    if 'cell_v_delta' in df_v.columns:
        axes[1].plot(x, df_v['cell_v_delta'], color='#FF5722', lw=1)
        axes[1].axhline(0.3, color='red', linestyle='--', alpha=0.5, label='报警阈值')
        axes[1].set_ylabel('压差 (V)')
        axes[1].legend(loc='upper right', fontsize=8)
    elif 'maxbuv' in df_v.columns and 'minbuv' in df_v.columns:
        dv = df_v['maxbuv'] - df_v['minbuv']
        axes[1].plot(x, dv, color='#FF5722', lw=1)
        axes[1].axhline(0.3, color='red', linestyle='--', alpha=0.5)
        axes[1].set_ylabel('压差 (V)')

    # 温度
    if 'maxt' in df_v.columns:
        axes[2].plot(x, df_v['maxt'], color='#FF9800', lw=1, label='最高温')
    if 'mint' in df_v.columns:
        axes[2].plot(x, df_v['mint'], color='#03A9F4', lw=1, label='最低温')
    axes[2].axhline(45, color='red', linestyle='--', alpha=0.5)
    axes[2].set_ylabel('温度 (°C)')
    axes[2].legend(loc='upper right', fontsize=8)

    # 电流
    if 'tbc' in df_v.columns:
        axes[3].plot(x, df_v['tbc'], color='#9C27B0', lw=1)
        axes[3].axhline(0, color='gray', linestyle='-', alpha=0.3)
        axes[3].set_ylabel('电流 (A)')

    # 绝缘电阻
    if 'inre' in df_v.columns:
        inre = df_v['inre'].replace(9999, float('nan'))
        axes[4].plot(x, inre, color='#607D8B', lw=1)
        axes[4].axhline(500, color='orange', linestyle='--', alpha=0.5, label='预警')
        axes[4].axhline(100, color='red',    linestyle='--', alpha=0.5, label='报警')
        axes[4].set_ylabel('绝缘电阻 (Ω)')
        axes[4].legend(loc='upper right', fontsize=8)

    axes[-1].set_xlabel('时间序列索引')
    plt.tight_layout()

    path = f'output/figures/single_vehicle_{vin}.png'
    plt.savefig(path, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"[INFO] 单车时序图已保存: {path}")


def step_sample():
    """生成测试数据并完整运行"""
    print("\n[STEP] 生成测试样本数据...")
    import generate_sample_data
    generate_sample_data.main()

    step_label()
    df_processed, final_risks, _ = step_run()
    step_viz(df_processed, final_risks)


def main():
    args = parse_args()

    print("\n" + "=" * 55)
    print("  动力电池风险识别系统")
    print(f"  运行模式: {args.mode}")
    print("=" * 55)

    if args.mode == 'label':
        step_label()

    elif args.mode == 'run':
        step_run(args.sample_size)

    elif args.mode == 'viz':
        step_viz(vin=args.vin)

    elif args.mode == 'all':
        step_label()
        df_processed, final_risks, _ = step_run(args.sample_size)
        step_viz(df_processed, final_risks, args.vin)

    elif args.mode == 'sample':
        step_sample()

    print("\n[完成] 所有任务执行完毕")


if __name__ == '__main__':
    main()
```

