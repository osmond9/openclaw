# 13. L2 故障绝缘风险算法

## 📄 battery_risk/modules/fault_risk.py

```python
"""
fault_risk.py - L2 故障/绝缘/告警风险算法

可用字段：inre, halvl, uai, aobf, aodmf, aoef, aoof, estate
风险识别：
  1. 绝缘电阻低/快速下降
  2. 电池故障码数量
  3. 电机故障
  4. 多系统同时故障
  5. 严重报警等级
  6. 故障复发性
"""

import numpy as np
import pandas as pd
from scipy import stats
from battery_risk.config import (
    FAULT_INSULATION_LOW, FAULT_INSULATION_WARN,
    FAULT_INSULATION_SLOPE, FAULT_CODE_WEIGHT,
    HALVL_SERIOUS, BATTERY_FAULT_CNT_TH,
    MULTI_SYSTEM_FAULT_TH, VOLT_WINDOW_SIZE
)


def fault_risk_enhanced(df: pd.DataFrame) -> pd.DataFrame:
    """
    故障/绝缘风险主函数

    输入：含 inre, halvl, uai, aobf, aodmf, aoef, aoof 的 DataFrame
    输出：新增 fault_risk_score 及中间特征列
    """
    print("[INFO] 开始 L2 故障/绝缘风险识别...")
    df = df.sort_values(['vin', 'date', 'time']).reset_index(drop=True)

    # ---------- 1. 绝缘电阻风险 ----------
    if 'inre' in df.columns:
        df['inre'] = df['inre'].fillna(9999)
        df['insulation_low']    = (df['inre'] < FAULT_INSULATION_LOW).astype(int)
        df['insulation_warn']   = (
            (df['inre'] >= FAULT_INSULATION_LOW) &
            (df['inre'] < FAULT_INSULATION_WARN)
        ).astype(int)

        # 绝缘下降斜率（滚动线性回归）
        grp = df.groupby('vin')
        W   = VOLT_WINDOW_SIZE

        def _insulation_slope(series, window=W):
            result = np.full(len(series), 0.0)
            arr = series.values
            for i in range(window - 1, len(arr)):
                y = arr[i - window + 1: i + 1]
                if np.all(np.isfinite(y)):
                    x = np.arange(window)
                    slope, *_ = stats.linregress(x, y)
                    result[i] = slope
            return result

        df['insulation_slope'] = grp['inre'].transform(
            lambda x: pd.Series(_insulation_slope(x, W), index=x.index)
        )
        # 斜率为负（下降）且超过阈值
        df['insulation_declining'] = (
            df['insulation_slope'] < FAULT_INSULATION_SLOPE
        ).astype(int)

        df['insulation_low_roll'] = grp['insulation_low'].transform(
            lambda x: x.rolling(W, min_periods=1).sum()
        )
        df['insulation_warn_roll'] = grp['insulation_warn'].transform(
            lambda x: x.rolling(W, min_periods=1).sum()
        )
    else:
        df['insulation_low']       = 0
        df['insulation_warn']      = 0
        df['insulation_declining'] = 0
        df['insulation_low_roll']  = 0
        df['insulation_warn_roll'] = 0
        grp = df.groupby('vin')
        W   = VOLT_WINDOW_SIZE

    # ---------- 2. 故障码数量 ----------
    fault_cols = {
        'aobf':  'battery_fault_cnt',  # 电池故障
        'aodmf': 'motor_fault_cnt',    # 电机故障
        'aoef':  'engine_fault_cnt',   # 发动机故障（PHEV）
        'aoof':  'other_fault_cnt',    # 其他故障
    }
    for src, dst in fault_cols.items():
        if src in df.columns:
            df[dst] = df[src].fillna(0).astype(int)
        else:
            df[dst] = 0

    df['total_fault_cnt'] = (
        df['battery_fault_cnt'] + df['motor_fault_cnt'] +
        df['engine_fault_cnt'] + df['other_fault_cnt']
    )

    # ---------- 3. 多系统同时故障 ----------
    system_fault_flags = pd.DataFrame({
        'bat': (df['battery_fault_cnt'] > 0).astype(int),
        'mot': (df['motor_fault_cnt'] > 0).astype(int),
        'eng': (df['engine_fault_cnt'] > 0).astype(int),
        'oth': (df['other_fault_cnt'] > 0).astype(int),
    })
    df['multi_system_fault_cnt'] = system_fault_flags.sum(axis=1)
    df['multi_system_fault_flag'] = (
        df['multi_system_fault_cnt'] >= MULTI_SYSTEM_FAULT_TH
    ).astype(int)

    # ---------- 4. 严重报警等级 ----------
    if 'halvl' in df.columns:
        df['halvl'] = df['halvl'].fillna(0).astype(int)
        df['serious_alarm_flag'] = (df['halvl'] >= HALVL_SERIOUS).astype(int)
    else:
        df['serious_alarm_flag'] = 0

    # ---------- 5. 滚动统计 ----------
    df['battery_fault_roll'] = grp['battery_fault_cnt'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['total_fault_roll'] = grp['total_fault_cnt'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['serious_alarm_roll'] = grp['serious_alarm_flag'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['multi_system_fault_roll'] = grp['multi_system_fault_flag'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )

    # ---------- 6. 综合故障风险评分 ----------
    score_insulation = (
        (df['insulation_low_roll'] * 1.0 +
         df['insulation_warn_roll'] * 0.3 +
         df['insulation_declining'].astype(float) * 0.5) / W
    ).clip(0, 1) * 1.0

    score_battery_fault = (
        (df['battery_fault_roll'] / (W * BATTERY_FAULT_CNT_TH))
    ).clip(0, 1) * 0.8

    score_multi_fault = (
        df['multi_system_fault_roll'] / W
    ).clip(0, 1) * 0.7

    score_serious_alarm = (
        df['serious_alarm_roll'] / W
    ).clip(0, 1) * 1.0

    df['fault_risk_score'] = (
        score_insulation + score_battery_fault +
        score_multi_fault + score_serious_alarm
    ).clip(0, 3.0).round(4)

    print(f"[INFO] 故障风险识别完成，"
          f"平均分: {df['fault_risk_score'].mean():.4f}, "
          f"最大分: {df['fault_risk_score'].max():.4f}")
    return df
