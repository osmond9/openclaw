    print(f"[INFO] 风险结果已保存: {path}")
    print(f"[INFO] 共 {len(df)} 辆车")


def ensure_figure_dir() -> str:
    os.makedirs(FIGURE_DIR, exist_ok=True)
    return FIGURE_DIR
