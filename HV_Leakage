# 10. L2 温度热风险算法

## 📄 battery_risk/modules/temperature_risk.py

```python
"""
temperature_risk.py - L2 温度/热风险算法

可用字段：maxt, mint, maxtn, mintn, matban, mitban
注意：无温度探针明细，只有最高/最低温度及探针号

风险识别：
  1. 高温/低温绝对值风险
  2. 温差（热均匀性）风险
  3. 温升速率（热失控前兆）
  4. 静置异常升温
  5. 充电异常温升
  6. 固定热点探针
  7. 温差趋势恶化
"""

import numpy as np
import pandas as pd
from scipy import stats
from battery_risk.config import (
    TEMP_MAX_THRESHOLD, TEMP_HIGH_WARNING,
    TEMP_MIN_THRESHOLD, TEMP_DIFF_THRESHOLD,
    TEMP_DIFF_WARNING, TEMP_RISE_RATE_THRESHOLD,
    TEMP_WINDOW_SIZE, HOT_PROBE_REPEAT_TH,
    STATIC_TEMP_RISE_TH, CHARGE_TEMP_RISE_RATE
)


def temperature_risk_enhanced(df: pd.DataFrame) -> pd.DataFrame:
    """
    温度热风险主函数
    输入：含 maxt, mint, maxtn, mintn, scene_tag, soc 的 DataFrame
    输出：新增 temp_risk_score 及中间特征列
    """
    print("[INFO] 开始 L2 温度/热风险识别...")
    df = df.sort_values(['vin', 'date', 'time']).reset_index(drop=True)

    # ---------- 1. 基础温差特征 ----------
    df['temp_delta'] = (df['maxt'] - df['mint']).clip(lower=0)

    # ---------- 2. 温度绝对值标记 ----------
    df['temp_over']    = (df['maxt'] > TEMP_MAX_THRESHOLD).astype(int)
    df['temp_warning'] = (
        (df['maxt'] > TEMP_HIGH_WARNING) &
        (df['maxt'] <= TEMP_MAX_THRESHOLD)
    ).astype(int)
    df['temp_under']   = (df['mint'] < TEMP_MIN_THRESHOLD).astype(int)

    # ---------- 3. 温差等级标记 ----------
    df['temp_diff_critical'] = (df['temp_delta'] > TEMP_DIFF_THRESHOLD).astype(int)
    df['temp_diff_warning']  = (
        (df['temp_delta'] > TEMP_DIFF_WARNING) &
        (df['temp_delta'] <= TEMP_DIFF_THRESHOLD)
    ).astype(int)

    # ---------- 4. 温升速率（°C/条，近似°C/采样间隔）----------
    grp = df.groupby('vin')
    W   = TEMP_WINDOW_SIZE

    df['temp_rise_rate'] = grp['maxt'].transform(
        lambda x: x.diff().fillna(0)
    )
    # 平滑温升速率（避免单点噪声）
    df['temp_rise_rate_smooth'] = grp['temp_rise_rate'].transform(
        lambda x: x.rolling(3, min_periods=1).mean()
    )
    df['temp_rise_fast'] = (
        df['temp_rise_rate_smooth'] > TEMP_RISE_RATE_THRESHOLD
    ).astype(int)

    # ---------- 5. 充电工况温升 ----------
    df['temp_rise_charge'] = np.where(
        df.get('scene_tag', pd.Series('', index=df.index)).isin(
            ['fast_charge', 'slow_charge']
        ),
        df['temp_rise_rate_smooth'],
        np.nan
    )
    df['temp_rise_charge_fast'] = (
        df['temp_rise_charge'].fillna(0) > CHARGE_TEMP_RISE_RATE
    ).astype(int)

    # ---------- 6. 静置温升（静置状态下温度上升） ----------
    is_static = df.get('is_static_state', pd.Series(0, index=df.index)) == 1
    df['temp_rise_static'] = np.where(
        is_static, df['temp_rise_rate_smooth'], np.nan
    )
    df['temp_rise_static_abnormal'] = (
        df['temp_rise_static'].fillna(0) > STATIC_TEMP_RISE_TH
    ).astype(int)

    # ---------- 7. 滚动窗口统计 ----------
    df['temp_max_roll']           = grp['maxt'].transform(
        lambda x: x.rolling(W, min_periods=1).max()
    )
    df['temp_delta_roll_max']     = grp['temp_delta'].transform(
        lambda x: x.rolling(W, min_periods=1).max()
    )
    df['temp_delta_roll_mean']    = grp['temp_delta'].transform(
        lambda x: x.rolling(W, min_periods=1).mean()
    )
    df['temp_over_roll']          = grp['temp_over'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['temp_under_roll']         = grp['temp_under'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['temp_diff_critical_roll'] = grp['temp_diff_critical'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['temp_rise_fast_roll']     = grp['temp_rise_fast'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['temp_rise_charge_roll']   = grp['temp_rise_charge_fast'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )
    df['temp_rise_static_roll']   = grp['temp_rise_static_abnormal'].transform(
        lambda x: x.rolling(W, min_periods=1).sum()
    )

    # ---------- 8. 温差趋势斜率 ----------
    def _rolling_slope(series, window=W):
        result = np.full(len(series), 0.0)
        arr = series.values
        for i in range(window - 1, len(arr)):
            y = arr[i - window + 1: i + 1]
            if np.all(np.isfinite(y)):
                x = np.arange(window)
                slope, *_ = stats.linregress(x, y)
                result[i] = slope
        return result

    df['temp_delta_slope'] = grp['temp_delta'].transform(
        lambda x: pd.Series(_rolling_slope(x, W), index=x.index)
    )
    df['temp_diff_deteriorating'] = (df['temp_delta_slope'] > 0.05).astype(int)

    # ---------- 9. 固定热点探针识别 ----------
    def _repeat_probe_count(g, col, window=20):
        vals = g[col].values
        result = np.zeros(len(vals), dtype=int)
        for i in range(len(vals)):
            start = max(0, i - window + 1)
            w_vals = vals[start:i + 1]
            if len(w_vals) > 0 and not np.isnan(vals[i]):
                result[i] = int(np.sum(w_vals == vals[i]))
        return pd.Series(result, index=g.index)

    if 'maxtn' in df.columns:
        df['hot_probe_repeat_cnt'] = grp.apply(
            lambda g: _repeat_probe_count(g, 'maxtn', 20)
        ).reset_index(drop=True)
    else:
        df['hot_probe_repeat_cnt'] = 0

    df['hot_probe_flag'] = (
        df['hot_probe_repeat_cnt'] >= HOT_PROBE_REPEAT_TH
    ).astype(int)

    # ---------- 10. 综合温度风险评分 ----------
    score_over_under = (
        (df['temp_over_roll'] * 0.7 + df['temp_under_roll'] * 0.3) / W
    ).clip(0, 1) * 1.0

    score_diff = (
        df['temp_diff_critical_roll'] / W
    ).clip(0, 1) * 0.7

    score_rise_fast = (
        df['temp_rise_fast_roll'] / W
    ).clip(0, 1) * 0.8

    score_charge_rise = (
        df['temp_rise_charge_roll'] / W
    ).clip(0, 1) * 0.5

    score_static_rise = (
        df['temp_rise_static_roll'] / W
    ).clip(0, 1) * 0.5

    score_hot_probe = df['hot_probe_flag'].astype(float) * 0.3

    score_deteriorate = df['temp_diff_deteriorating'].astype(float) * 0.2

    df['temp_risk_score'] = (
        score_over_under + score_diff + score_rise_fast +
        score_charge_rise + score_static_rise +
        score_hot_probe + score_deteriorate
    ).clip(0, 3.0).round(4)

    # ---------- 11. 热点探针号记录 ----------
    df['hot_probe_no'] = np.where(
        df['temp_risk_score'] > 1.0,
        df.get('maxtn', pd.Series(np.nan, index=df.index)),
        np.nan
    )

    print(f"[INFO] 温度风险识别完成，"
          f"平均分: {df['temp_risk_score'].mean():.4f}, "
          f"最大分: {df['temp_risk_score'].max():.4f}")
    return df
